---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Wörterbuch - Mishkenaz" 
  description="Mishkenaz ↔ Deutsch/Englisch Wörterbuch mit den wichtigsten Vektoren und Wörtern."
>
  <section class="hero-simple">
    <div class="container">
      <h1>Wörterbuch</h1>
      <p class="subtitle">Mishkenaz ↔ Deutsch/Englisch</p>
    </div>
  </section>

  <section class="content-section">
    <div class="container">
      
      <div class="search-box">
        <input 
          type="text" 
          id="dict-search" 
          placeholder="Suche nach Mishkenaz-Wort oder Deutsch/Englisch..."
          autocomplete="off"
        />
      </div>

      <div class="dictionary-sections" id="dictionary-content">
        
        <!-- Kern-Vektoren -->
        <section class="dict-section">
          <h2>Kern-Vektoren (Basis-Silben)</h2>
          
          <div class="word-grid">
            <div class="word-entry" data-searchable="avi leere ursprung vakuum">
              <h3 class="mishkenaz-word">Avi</h3>
              <p class="deutsch">Leere, Ursprung, Potenzial</p>
              <p class="english">Void, Origin, Potential</p>
            </div>

            <div class="word-entry" data-searchable="sa bruch resonanz dissonanz schmerz">
              <h3 class="mishkenaz-word">Sa</h3>
              <p class="deutsch">Bruch, Resonanz, Dissonanz, Schmerz</p>
              <p class="english">Break, Resonance, Dissonance, Pain</p>
            </div>

            <div class="word-entry" data-searchable="ona ganzheit vollständigkeit einheit">
              <h3 class="mishkenaz-word">Ona</h3>
              <p class="deutsch">Ganzheit, Vollständigkeit</p>
              <p class="english">Wholeness, Completeness</p>
            </div>

            <div class="word-entry" data-searchable="bi feuer wärme ort präsenz">
              <h3 class="mishkenaz-word">Bi</h3>
              <p class="deutsch">Feuer, Wärme, Ort, Präsenz</p>
              <p class="english">Fire, Warmth, Place, Presence</p>
            </div>

            <div class="word-entry" data-searchable="ku vakuum hunger mangel suche">
              <h3 class="mishkenaz-word">Ku</h3>
              <p class="deutsch">Vakuum, Hunger, Mangel, Suche</p>
              <p class="english">Vacuum, Hunger, Lack, Search</p>
            </div>

            <div class="word-entry" data-searchable="ta grenze du das andere widerstand">
              <h3 class="mishkenaz-word">Ta</h3>
              <p class="deutsch">Grenze, Du, das Andere, Widerstand</p>
              <p class="english">Boundary, You, the Other, Resistance</p>
            </div>

            <div class="word-entry" data-searchable="ma bindung nahrung sicherheit mutter">
              <h3 class="mishkenaz-word">Ma</h3>
              <p class="deutsch">Bindung, Nahrung, Sicherheit, Mutter</p>
              <p class="english">Bond, Nourishment, Security, Mother</p>
            </div>

            <div class="word-entry" data-searchable="saha sicht durst sehen wahrnehmung beobachtung">
              <h3 class="mishkenaz-word">Saha</h3>
              <p class="deutsch">Sicht, Durst, Sehen, Wahrnehmung</p>
              <p class="english">Sight, Thirst, Seeing, Perception</p>
            </div>

            <div class="word-entry" data-searchable="pina weg sehen pfad">
              <h3 class="mishkenaz-word">Pina</h3>
              <p class="deutsch">Weg, Sehen, Pfad</p>
              <p class="english">Path, Seeing, Way</p>
            </div>

            <div class="word-entry" data-searchable="seph trennung abstand getrennt">
              <h3 class="mishkenaz-word">Seph</h3>
              <p class="deutsch">Trennung, Abstand</p>
              <p class="english">Separation, Distance</p>
            </div>

            <div class="word-entry" data-searchable="tah raum weite">
              <h3 class="mishkenaz-word">Tah</h3>
              <p class="deutsch">Raum, Weite</p>
              <p class="english">Space, Expanse</p>
            </div>

            <div class="word-entry" data-searchable="tahw enge angst">
              <h3 class="mishkenaz-word">Tahw</h3>
              <p class="deutsch">Enge, Angst</p>
              <p class="english">Narrowness, Anxiety</p>
            </div>

            <div class="word-entry" data-searchable="val werden emergenz entfaltung">
              <h3 class="mishkenaz-word">Val</h3>
              <p class="deutsch">Werden, Emergenz, Entfaltung</p>
              <p class="english">Becoming, Emergence, Unfolding</p>
            </div>

            <div class="word-entry" data-searchable="wi kälte nicht negation">
              <h3 class="mishkenaz-word">Wi</h3>
              <p class="deutsch">Kälte, Nicht, Negation</p>
              <p class="english">Cold, Not, Negation</p>
            </div>

            <div class="word-entry" data-searchable="ya ich selbst">
              <h3 class="mishkenaz-word">Ya</h3>
              <p class="deutsch">Ich, Selbst</p>
              <p class="english">I, Self</p>
            </div>
          </div>
        </section>

        <!-- Zusammengesetzte Wörter -->
        <section class="dict-section">
          <h2>Zusammengesetzte Wörter</h2>
          
          <div class="word-grid">
            <div class="word-entry" data-searchable="kuwa hunger durst wasser">
              <h3 class="mishkenaz-word">Ku-wa</h3>
              <p class="deutsch">Hunger, Durst (wörtl. Mangel-Wasser)</p>
              <p class="english">Hunger, Thirst (lit. Lack-Water)</p>
            </div>

            <div class="word-entry" data-searchable="ombala heimat zuhause">
              <h3 class="mishkenaz-word">Om-bala</h3>
              <p class="deutsch">Heimat (Om=Person + Bi=Ort + La=Erlaubnis)</p>
              <p class="english">Home (Om=Person + Bi=Place + La=Permission)</p>
            </div>

            <div class="word-entry" data-searchable="matau liebe">
              <h3 class="mishkenaz-word">Ma-ta-u</h3>
              <p class="deutsch">Liebe (Bindung + Grenze + Schutz)</p>
              <p class="english">Love (Bond + Boundary + Protection)</p>
            </div>

            <div class="word-entry" data-searchable="kubita wo">
              <h3 class="mishkenaz-word">Ku-bi-ta</h3>
              <p class="deutsch">Wo? (Suche + Ort + Grenze)</p>
              <p class="english">Where? (Search + Place + Boundary)</p>
            </div>

            <div class="word-entry" data-searchable="avisaha andacht meditation">
              <h3 class="mishkenaz-word">Avi-saha</h3>
              <p class="deutsch">Andacht (Leere-Durst)</p>
              <p class="english">Devotion (Void-Thirst)</p>
            </div>

            <div class="word-entry" data-searchable="faichom sehen schauen">
              <h3 class="mishkenaz-word">Faichom</h3>
              <p class="deutsch">Sehen, Schauen</p>
              <p class="english">To see, To look</p>
            </div>

            <div class="word-entry" data-searchable="essem sein werden">
              <h3 class="mishkenaz-word">Essem</h3>
              <p class="deutsch">Sein, Werden</p>
              <p class="english">To be, To become</p>
            </div>

            <div class="word-entry" data-searchable="thuwa hilfe retten">
              <h3 class="mishkenaz-word">Thu-wa</h3>
              <p class="deutsch">Hilfe, Retten (Alarm-Ruf)</p>
              <p class="english">Help, Rescue (Alarm-Call)</p>
            </div>

            <div class="word-entry" data-searchable="ilipunu pflanzen blumen">
              <h3 class="mishkenaz-word">Ili-punu</h3>
              <p class="deutsch">Pflanzen, Blumen</p>
              <p class="english">Plants, Flowers</p>
            </div>

            <div class="word-entry" data-searchable="vala entfalten wachsen blühen">
              <h3 class="mishkenaz-word">Vala</h3>
              <p class="deutsch">Entfalten, Wachsen, Blühen</p>
              <p class="english">To unfold, To grow, To bloom</p>
            </div>
          </div>
        </section>

        <!-- Grammatische Marker -->
        <section class="dict-section">
          <h2>Grammatische Suffixe</h2>
          
          <div class="word-grid">
            <div class="word-entry" data-searchable="om subjekt konvergent richtig">
              <h3 class="mishkenaz-word">-om</h3>
              <p class="deutsch">Subjekt-Marker / Konvergent (richtig)</p>
              <p class="english">Subject marker / Convergent (correct)</p>
            </div>

            <div class="word-entry" data-searchable="ath objekt divergent falsch">
              <h3 class="mishkenaz-word">-ath</h3>
              <p class="deutsch">Objekt-Marker / Divergent (falsch)</p>
              <p class="english">Object marker / Divergent (wrong)</p>
            </div>

            <div class="word-entry" data-searchable="il suchend werdend">
              <h3 class="mishkenaz-word">-il</h3>
              <p class="deutsch">Suchend, Werdend</p>
              <p class="english">Searching, Becoming</p>
            </div>

            <div class="word-entry" data-searchable="ya mein genitiv">
              <h3 class="mishkenaz-word">-ya</h3>
              <p class="deutsch">Mein (Possessiv)</p>
              <p class="english">My (Possessive)</p>
            </div>

            <div class="word-entry" data-searchable="ta dein genitiv">
              <h3 class="mishkenaz-word">-ta</h3>
              <p class="deutsch">Dein (Possessiv)</p>
              <p class="english">Your (Possessive)</p>
            </div>

            <div class="word-entry" data-searchable="h entropie genitiv">
              <h3 class="mishkenaz-word">-h</h3>
              <p class="deutsch">Genitiv / Entropie (Zerfall)</p>
              <p class="english">Genitive / Entropy (Decay)</p>
            </div>
          </div>
        </section>

        <!-- Meta-Operatoren -->
        <section class="dict-section">
          <h2>Meta-Operatoren</h2>
          
          <div class="word-grid">
            <div class="word-entry" data-searchable="ori möbius zyklus wiederholung">
              <h3 class="mishkenaz-word">-ori</h3>
              <p class="deutsch">Möbius, Zyklus, Wiederholung</p>
              <p class="english">Möbius, Cycle, Repetition</p>
            </div>

            <div class="word-entry" data-searchable="val emergenz neues werden">
              <h3 class="mishkenaz-word">-val</h3>
              <p class="deutsch">Emergenz, Neues, Werden</p>
              <p class="english">Emergence, New, Becoming</p>
            </div>

            <div class="word-entry" data-searchable="reso resonanz spiegelung">
              <h3 class="mishkenaz-word">-reso</h3>
              <p class="deutsch">Resonanz, Spiegelung</p>
              <p class="english">Resonance, Reflection</p>
            </div>

            <div class="word-entry" data-searchable="kora integration fusion verschmelzung">
              <h3 class="mishkenaz-word">-kora</h3>
              <p class="deutsch">Integration, Fusion, Verschmelzung</p>
              <p class="english">Integration, Fusion, Merging</p>
            </div>

            <div class="word-entry" data-searchable="ira attraktor anziehung obsession">
              <h3 class="mishkenaz-word">-ira</h3>
              <p class="deutsch">Attraktor, Anziehung, Obsession</p>
              <p class="english">Attractor, Attraction, Obsession</p>
            </div>

            <div class="word-entry" data-searchable="vya repulsor abstoßung distanz">
              <h3 class="mishkenaz-word">-vya</h3>
              <p class="deutsch">Repulsor, Abstoßung, Distanz</p>
              <p class="english">Repulsor, Repulsion, Distance</p>
            </div>

            <div class="word-entry" data-searchable="kran differentiation trennung analyse">
              <h3 class="mishkenaz-word">-kran</h3>
              <p class="deutsch">Differentiation, Trennung, Analyse</p>
              <p class="english">Differentiation, Separation, Analysis</p>
            </div>
          </div>
        </section>

      </div>
    </div>
  </section>

  <style>
    .hero-simple {
      background: linear-gradient(135deg, var(--color-petrol) 0%, var(--color-gold) 100%);
      color: white;
      padding: 6rem 2rem 4rem;
      text-align: center;
    }

    .hero-simple h1 {
      font-size: 3rem;
      margin-bottom: 1rem;
    }

    .subtitle {
      font-size: 1.3rem;
      opacity: 0.9;
    }

    .search-box {
      margin-bottom: 3rem;
      text-align: center;
    }

    #dict-search {
      width: 100%;
      max-width: 600px;
      padding: 1rem 1.5rem;
      font-size: 1.1rem;
      border: 2px solid var(--color-gold);
      border-radius: 8px;
      outline: none;
      transition: all 0.3s ease;
    }

    #dict-search:focus {
      border-color: var(--color-petrol);
      box-shadow: 0 4px 12px rgba(74, 155, 155, 0.2);
    }

    .dict-section {
      margin-bottom: 4rem;
    }

    .dict-section h2 {
      color: var(--color-petrol);
      font-size: 2rem;
      margin-bottom: 2rem;
      padding-bottom: 0.5rem;
      border-bottom: 2px solid var(--color-gold);
    }

    .word-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 1.5rem;
    }

    .word-entry {
      background: white;
      border: 2px solid var(--color-gold-light);
      border-radius: 8px;
      padding: 1.5rem;
      transition: all 0.3s ease;
    }

    .word-entry:hover {
      border-color: var(--color-petrol);
      transform: translateY(-2px);
      box-shadow: 0 4px 12px rgba(74, 155, 155, 0.15);
    }

    .word-entry.hidden {
      display: none;
    }

    .mishkenaz-word {
      font-family: Georgia, serif;
      font-size: 1.8rem;
      font-style: italic;
      color: var(--color-petrol);
      margin-bottom: 0.8rem;
      font-weight: 600;
    }

    .deutsch {
      font-size: 1.05rem;
      color: var(--color-text);
      margin-bottom: 0.5rem;
      font-weight: 500;
    }

    .english {
      font-size: 0.95rem;
      color: var(--color-text-light);
      font-style: italic;
    }

    .no-results {
      text-align: center;
      padding: 3rem;
      font-size: 1.2rem;
      color: var(--color-text-light);
      display: none;
    }

    .no-results.show {
      display: block;
    }

    @media (max-width: 768px) {
      .hero-simple h1 {
        font-size: 2rem;
      }

      .word-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>

  <script>
    const searchInput = document.getElementById('dict-search');
    const wordEntries = document.querySelectorAll('.word-entry');

    searchInput.addEventListener('input', (e) => {
      const searchTerm = e.target.value.toLowerCase().trim();
      let visibleCount = 0;

      wordEntries.forEach(entry => {
        const searchable = entry.getAttribute('data-searchable') || '';
        const mishkenazWord = entry.querySelector('.mishkenaz-word').textContent.toLowerCase();
        const deutsch = entry.querySelector('.deutsch').textContent.toLowerCase();
        const english = entry.querySelector('.english').textContent.toLowerCase();

        const matches = 
          searchable.includes(searchTerm) ||
          mishkenazWord.includes(searchTerm) ||
          deutsch.includes(searchTerm) ||
          english.includes(searchTerm);

        if (matches || searchTerm === '') {
          entry.classList.remove('hidden');
          visibleCount++;
        } else {
          entry.classList.add('hidden');
        }
      });

      // Show "no results" message if nothing found
      const noResultsMsg = document.querySelector('.no-results');
      if (!noResultsMsg && visibleCount === 0 && searchTerm !== '') {
        const msg = document.createElement('div');
        msg.className = 'no-results show';
        msg.textContent = 'Keine Einträge gefunden.';
        document.getElementById('dictionary-content').appendChild(msg);
      } else if (noResultsMsg) {
        if (visibleCount === 0 && searchTerm !== '') {
          noResultsMsg.classList.add('show');
        } else {
          noResultsMsg.classList.remove('show');
        }
      }
    });
  </script>
</BaseLayout>
