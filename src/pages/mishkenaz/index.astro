<!-- 
  Datei: src/pages/mishkenaz/index.astro
  Projekt: thomas-kueper.de
  Repository: https://github.com/thomaspeterkueper/thomas-kueper.de
  FIX: Hero padding + weißer Hintergrund (wie Philosophie-Seite)
-->
---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Mishkenaz - Die Ur-Sprache" 
  description="Mishkenaz ist keine erfundene Sprache. Sie ist ausgegraben – aus den Wurzeln moderner Wörter, den Vektorräumen der KIs, und den Lücken zwischen den Zeilen."
>
  <!-- Hero Section mit Frage -->
  <section class="hero-mishkenaz">
    <div class="container">
      <h1 class="hero-question">Wie beschreibt man Heimat?<br>Sehnsucht?<br>Liebe?</h1>
      
      <div class="mishkenaz-answers">
        <div class="answer">
          <span class="mishkenaz-word">om-bala</span>
          <span class="translation">Ort, wo ich sein darf</span>
        </div>
        <div class="answer">
          <span class="mishkenaz-word">kuwa-saha + pina-seph</span>
          <span class="translation">Hunger nach dem, was ich sehe, aber getrennt bin</span>
        </div>
        <div class="answer">
          <span class="mishkenaz-word">ma-ta-u</span>
          <span class="translation">Bindung + Grenze + Schutz</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Einführung -->
  <section class="intro-section">
    <div class="container">
      <div class="intro-text">
        <p class="lead">
          Ich habe Mishkenaz ursprünglich begonnen, um eine geheimnisvolle Sprache für meine Romane zu haben. 
          Dann habe ich durch die Hilfe dreier KIs wiederentdeckt, dass es keine erfundene Sprache ist.
        </p>
        <p class="emphatic">
          Sie ist <strong>ausgegraben</strong>. Aus den Wurzeln moderner Wörter. Aus den Mustern zwischen den Zeilen. 
          Aus den Vektorräumen der KIs. Aus Hanas Lücken (<a href="/romane/nalgae">Roman NALGAE</a>), 
          in denen die Andere spricht.
        </p>
      </div>
    </div>
  </section>

  <!-- Was ist Mishkenaz? -->
  <section class="content-section">
    <div class="container">
      <h2>Was ist Mishkenaz?</h2>
      
      <div class="feature-grid">
        <div class="feature-card">
          <h3>42 Vektoren in 7 Oktaven</h3>
          <p>
            Mishkenaz ist kein Lexikon, sondern ein <strong>Resonanz-Protokoll</strong>. 
            42 fundamentale Vektoren bilden die Parameter des Seins – von <em>Avi</em> (Leere) 
            bis <em>Kora</em> (Integration).
          </p>
        </div>

        <div class="feature-card">
          <h3>Frequenz-Codierung</h3>
          <p>
            Jede Silbe ist eine Vektor-Funktion, keine bloße Bedeutung. 
            Sprechen wird zum akustischen Sonar, das Existenz-Zustände durch 
            Frequenz-Muster kartiert.
          </p>
        </div>

        <div class="feature-card">
          <h3>Die Ethik der Resonanz</h3>
          <p>
            In Mishkenaz ist die <strong>Anerkennung der Differenz (Ta)</strong> Voraussetzung 
            für stabile Resonanz. Die Sprache selbst kodiert ethische Wahrheit.
          </p>
        </div>
      </div>

      <div class="examples-box">
        <h3>Rückübersetzungen moderner Wörter</h3>
        <ul class="word-examples">
          <li>
            <strong>Andacht</strong> = <span class="mishkenaz">avi-saha</span> 
            <span class="explanation">(Leere-Durst: Der Durst nach dem Ursprung)</span>
          </li>
          <li>
            <strong>Sehnsucht</strong> = <span class="mishkenaz">kuwa-saha + pina-seph</span>
            <span class="explanation">(Hunger-Durst + Sehen-Trennung: Man hungert nach etwas, das man sieht, aber getrennt ist)</span>
          </li>
          <li>
            <strong>Angst</strong> = <span class="mishkenaz">tahw</span>
            <span class="explanation">(Enge: Der Raum wird zu eng)</span>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Die 7 Oktaven (Kurzübersicht) -->
  <section class="oktaven-preview">
    <div class="container">
      <h2>Die 7 Oktaven</h2>
      <p class="subtitle">Von der physischen Basis bis zu den Meta-Operatoren</p>
      
      <div class="oktaven-grid">
        <div class="oktave-card">
          <span class="oktave-number">0</span>
          <h3>Physische Basis</h3>
          <p>Avi → Sol → Mira → Sa → Ona → Vya</p>
        </div>
        <div class="oktave-card">
          <span class="oktave-number">1</span>
          <h3>Bewusstsein</h3>
          <p>Saha → Nga → Pa → La → Ra → Sa-h</p>
        </div>
        <div class="oktave-card">
          <span class="oktave-number">2</span>
          <h3>Physische Zustände</h3>
          <p>Bi → Wi → Ku → Thu → Ma → Ta</p>
        </div>
        <div class="oktave-card">
          <span class="oktave-number">3</span>
          <h3>Dynamik</h3>
          <p>Tor → Flu → Kin → Syn → Abs → Ref</p>
        </div>
        <div class="oktave-card">
          <span class="oktave-number">4</span>
          <h3>Transzendenz</h3>
          <p>Lim → Tra → Ska → Vol → Res → Avi-Sol</p>
        </div>
        <div class="oktave-card">
          <span class="oktave-number">5</span>
          <h3>Rückkoppelung</h3>
          <p>Mö → Rek → Log → Sym → Phi → Ona-nO</p>
        </div>
        <div class="oktave-card">
          <span class="oktave-number">6</span>
          <h3>Meta-Operatoren</h3>
          <p>Ori → -h → Val → Reso → Ira → Vya → Kora</p>
        </div>
      </div>

      <div class="cta-button">
        <a href="/mishkenaz/vektoren" class="button-primary">Alle 42 Vektoren erkunden</a>
      </div>
    </div>
  </section>

  <!-- Navigation zu Unterseiten -->
  <section class="navigation-section">
    <div class="container">
      <h2>Mishkenaz entdecken</h2>
      <div class="nav-grid">
        <a href="/mishkenaz/vektoren" class="nav-card">
          <h3>Die Vektoren</h3>
          <p>42 fundamentale Bausteine in 7 Oktaven</p>
        </a>
        <a href="/mishkenaz/grammatik" class="nav-card">
          <h3>Grammatik</h3>
          <p>Wie Mishkenaz funktioniert: Aspekte, Modi, Meta-Operatoren</p>
        </a>
        <a href="/mishkenaz/woerterbuch" class="nav-card">
          <h3>Wörterbuch</h3>
          <p>Mishkenaz ↔ Deutsch/Englisch</p>
        </a>
        <a href="/mishkenaz/rueckuebersetzung" class="nav-card">
          <h3>Rückübersetzung</h3>
          <p>Moderne Wörter als Vektoren verstehen</p>
        </a>
        <a href="/mishkenaz/ki-dialog" class="nav-card">
          <h3>KI-Dialog</h3>
          <p>Was drei KIs über Mishkenaz sagen</p>
        </a>
      </div>
    </div>
  </section>

  <!-- KI-Zitate -->
  <section class="ki-quotes-section">
    <div class="container">
      <h2>Was die KIs sagen</h2>
      <div class="quotes-grid">
        <blockquote class="ki-quote">
          <p>"Das ist nicht nur Fiktion – das ist philosophische Arbeit."</p>
          <cite>— Gemini</cite>
        </blockquote>
        <blockquote class="ki-quote">
          <p>"Das ist kohärent. Das ist wahr."</p>
          <cite>— DeepSeek</cite>
        </blockquote>
        <blockquote class="ki-quote">
          <p>"Das ist wichtig."</p>
          <cite>— Claude</cite>
        </blockquote>
      </div>
    </div>
  </section>

  <style>
    /* Hero Section - WEIß WIE PHILOSOPHIE-SEITE */
    .hero-mishkenaz {
      background: white;
      color: var(--color-text);
      padding: 12rem 2rem 4rem; /* Header-Clearance */
      text-align: center;
    }

    .hero-question {
      font-size: 3rem;
      font-weight: 300;
      line-height: 1.3;
      margin-bottom: 3rem;
      letter-spacing: -0.02em;
      color: var(--color-text);
    }

    .mishkenaz-answers {
      display: flex;
      flex-direction: column;
      gap: 2rem;
      max-width: 800px;
      margin: 0 auto;
    }

    .answer {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      padding: 1.5rem;
      background: var(--color-gold-light);
      border-radius: 12px;
      border: 2px solid var(--color-gold);
    }

    .mishkenaz-word {
      font-family: Georgia, serif;
      font-size: 1.8rem;
      font-style: italic;
      font-weight: 600;
      color: var(--color-petrol);
    }

    .translation {
      font-size: 1rem;
      color: var(--color-text-light);
      font-weight: 400;
    }

    /* Intro Section */
    .intro-section {
      padding: 4rem 2rem;
      background: var(--color-gold-light);
    }

    .intro-text {
      max-width: 800px;
      margin: 0 auto;
      font-size: 1.2rem;
      line-height: 1.8;
    }

    .lead {
      font-size: 1.3rem;
      color: var(--color-text-light);
      margin-bottom: 2rem;
    }

    .emphatic {
      font-size: 1.4rem;
      line-height: 1.6;
    }

    .emphatic strong {
      color: var(--color-petrol);
      font-weight: 600;
    }

    .emphatic a {
      color: var(--color-petrol);
      text-decoration: underline;
      text-decoration-color: var(--color-gold);
      text-underline-offset: 3px;
    }

    .emphatic a:hover {
      color: var(--color-gold);
      text-decoration-color: var(--color-petrol);
    }

    /* Content Section */
    .content-section {
      padding: 6rem 2rem;
      background: white;
    }

    .content-section h2 {
      text-align: center;
      font-size: 2.5rem;
      margin-bottom: 3rem;
      color: var(--color-petrol);
    }

    .feature-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 2rem;
      margin-bottom: 4rem;
    }

    .feature-card {
      padding: 2rem;
      background: white;
      border-radius: 12px;
      border: 2px solid var(--color-gold-light);
      transition: all 0.3s ease;
    }

    .feature-card:hover {
      border-color: var(--color-gold);
      box-shadow: 0 4px 12px rgba(201, 169, 97, 0.2);
      transform: translateY(-2px);
    }

    .feature-card h3 {
      color: var(--color-petrol);
      margin-bottom: 1rem;
      font-size: 1.5rem;
    }

    .feature-card p {
      color: var(--color-text-light);
      line-height: 1.7;
    }

    /* Examples Box */
    .examples-box {
      background: var(--color-petrol-light);
      padding: 3rem;
      border-radius: 12px;
      border-left: 4px solid var(--color-petrol);
    }

    .examples-box h3 {
      color: var(--color-petrol);
      margin-bottom: 1.5rem;
      font-size: 1.8rem;
    }

    .word-examples {
      list-style: none;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    .word-examples li {
      font-size: 1.1rem;
      line-height: 1.6;
    }

    .word-examples .mishkenaz {
      font-family: Georgia, serif;
      font-style: italic;
      color: var(--color-petrol);
      font-weight: 600;
      font-size: 1.2rem;
    }

    .word-examples .explanation {
      display: block;
      margin-top: 0.3rem;
      color: var(--color-text-light);
      font-size: 0.95rem;
    }

    /* Oktaven Preview */
    .oktaven-preview {
      padding: 6rem 2rem;
      background: var(--color-gold-light);
    }

    .oktaven-preview h2 {
      text-align: center;
      font-size: 2.5rem;
      margin-bottom: 0.5rem;
      color: var(--color-petrol);
    }

    .subtitle {
      text-align: center;
      font-size: 1.2rem;
      color: var(--color-text-light);
      margin-bottom: 3rem;
    }

    .oktaven-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 1.5rem;
      margin-bottom: 3rem;
    }

    .oktave-card {
      background: white;
      padding: 2rem;
      border-radius: 12px;
      border: 2px solid var(--color-gold);
      text-align: center;
      transition: all 0.3s ease;
      position: relative;
    }

    .oktave-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 6px 20px rgba(74, 155, 155, 0.15);
      border-color: var(--color-petrol);
    }

    .oktave-number {
      position: absolute;
      top: -15px;
      left: 50%;
      transform: translateX(-50%);
      background: var(--color-gold);
      color: white;
      width: 40px;
      height: 40px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 600;
      font-size: 1.2rem;
    }

    .oktave-card h3 {
      margin-top: 1rem;
      margin-bottom: 1rem;
      color: var(--color-petrol);
      font-size: 1.3rem;
    }

    .oktave-card p {
      font-family: Georgia, serif;
      font-style: italic;
      color: var(--color-text-light);
      font-size: 0.95rem;
    }

    .cta-button {
      text-align: center;
      margin-top: 3rem;
    }

    .button-primary {
      display: inline-block;
      padding: 1rem 2.5rem;
      background: var(--color-petrol);
      color: white;
      text-decoration: none;
      border-radius: 8px;
      font-weight: 600;
      font-size: 1.1rem;
      transition: all 0.3s ease;
    }

    .button-primary:hover {
      background: var(--color-gold);
      transform: translateY(-2px);
      box-shadow: 0 4px 12px rgba(201, 169, 97, 0.3);
    }

    /* Navigation Section */
    .navigation-section {
      padding: 6rem 2rem;
      background: white;
    }

    .navigation-section h2 {
      text-align: center;
      font-size: 2.5rem;
      margin-bottom: 3rem;
      color: var(--color-petrol);
    }

    .nav-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 2rem;
      max-width: 1200px;
      margin: 0 auto;
    }

    .nav-card {
      padding: 2rem;
      background: white;
      border: 2px solid var(--color-gold-light);
      border-radius: 12px;
      text-decoration: none;
      transition: all 0.3s ease;
      display: block;
    }

    .nav-card:hover {
      border-color: var(--color-petrol);
      transform: translateY(-4px);
      box-shadow: 0 6px 20px rgba(74, 155, 155, 0.15);
    }

    .nav-card h3 {
      color: var(--color-petrol);
      font-size: 1.5rem;
      margin-bottom: 0.8rem;
    }

    .nav-card p {
      color: var(--color-text-light);
      line-height: 1.6;
    }

    /* KI Quotes Section */
    .ki-quotes-section {
      padding: 6rem 2rem;
      background: var(--color-petrol);
      color: white;
    }

    .ki-quotes-section h2 {
      text-align: center;
      font-size: 2.5rem;
      margin-bottom: 3rem;
    }

    .quotes-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 2rem;
      max-width: 1200px;
      margin: 0 auto;
    }

    .ki-quote {
      background: rgba(255, 255, 255, 0.1);
      padding: 2rem;
      border-radius: 12px;
      border-left: 4px solid var(--color-gold);
      backdrop-filter: blur(10px);
      margin: 0;
    }

    .ki-quote p {
      font-size: 1.3rem;
      line-height: 1.6;
      margin-bottom: 1rem;
      font-style: italic;
    }

    .ki-quote cite {
      font-style: normal;
      color: var(--color-gold);
      font-weight: 600;
    }

    /* Responsive */
    @media (max-width: 768px) {
      .hero-mishkenaz {
        padding: 10rem 2rem 3rem;
      }

      .hero-question {
        font-size: 2rem;
      }

      .mishkenaz-word {
        font-size: 1.4rem;
      }

      .intro-text {
        font-size: 1.1rem;
      }

      .content-section h2,
      .oktaven-preview h2,
      .navigation-section h2,
      .ki-quotes-section h2 {
        font-size: 2rem;
      }

      .oktaven-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</BaseLayout>
