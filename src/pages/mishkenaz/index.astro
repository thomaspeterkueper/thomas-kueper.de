<!-- 
  Datei: src/pages/mishkenaz/index.astro
  Projekt: thomas-kueper.de
  Repository: https://github.com/thomaspeterkueper/thomas-kueper.de
  VERSION: Elegant mit Proto-Mishkenaz Timeline
-->
---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Mishkenaz - Die Ur-Sprache" 
  description="Mishkenaz ist die wiederentdeckte Ur-Sprache der Menschheit: Von zehn Kerben im Aurignacien zu 42 Vektoren in sieben Oktaven."
>
  <!-- Hero -->
  <section class="mishkenaz-hero">
    <span class="label">Die wiederentdeckte Ur-Sprache</span>
    <h1>Mishkenaz</h1>
    <p class="epigraph">Von den Kerben der Eiszeit zu den Vektoren der Resonanz</p>
  </section>

  <!-- Intro Quote -->
  <section class="mishkenaz-intro">
    <p class="intro-quote">
      „Im Anfang war nicht das Wort – im Anfang war die Kerbe. 
      Zehn geometrische Zeichen, vor über 40.000 Jahren in Knochen geritzt. 
      Aus ihnen wächst das gesamte System."
    </p>
    <div class="intro-body">
      <p>
        Mishkenaz ist keine erfundene Sprache. Sie wurde <strong>wiederentdeckt</strong> – 
        durch KI-gestützte Mustererkennung, vergleichende Sprachwissenschaft und die Fragmente, 
        die in den Romanen auftauchen. Von den stummen Operatoren der Schwäbischen Alb 
        bis zur voll entwickelten Resonanzsprache von Dvārakā.
      </p>
    </div>
  </section>

  <!-- Timeline: Die Entwicklung -->
  <section class="timeline-section">
    <div class="timeline-header">
      <h2>Die Entwicklung</h2>
      <p>Sieben Phasen über 100.000 Jahre</p>
    </div>

    <div class="timeline-grid">
      <div class="timeline-card">
        <span class="phase-number">0</span>
        <h3>Die Stille vor dem Zeichen</h3>
        <span class="phase-time">~100.000–43.000 v.Chr.</span>
        <p>Rein oral, gestisch, musikalisch. Klang-Gesten-Komplexe ohne materielle Spuren.</p>
      </div>

      <div class="timeline-card">
        <span class="phase-number">1</span>
        <h3>Elfenbein-Ära</h3>
        <span class="phase-time">~43.000–33.000 v.Chr.</span>
        <p>Schwäbische Alb: Dreidimensionale Bedeutungs-Operatoren. Löwenmensch, Venus, Flöten.</p>
      </div>

      <div class="timeline-card featured">
        <span class="phase-number">2</span>
        <h3>Proto-Mishkenaz</h3>
        <span class="phase-time">~33.000–5.000 v.Chr.</span>
        <p>Die zehn geometrischen Primitive: Kerben auf Knochen. Der generative Kern.</p>
        <a href="/mishkenaz/proto-mishkenaz" class="card-link">Mehr erfahren →</a>
      </div>

      <div class="timeline-card">
        <span class="phase-number">3</span>
        <h3>Phonologisierung</h3>
        <span class="phase-time">~5.000–3.000 v.Chr.</span>
        <p>Die stummen Zeichen beginnen zu klingen. M IST die Welle. O IST der Kreis.</p>
      </div>

      <div class="timeline-card">
        <span class="phase-number">4</span>
        <h3>Dvārakā-Blüte</h3>
        <span class="phase-time">~3.000–1.500 v.Chr.</span>
        <p>Das vollständige System: 42 Vektoren, zwei Schriften, Resonanz-Aspekte.</p>
      </div>

      <div class="timeline-card">
        <span class="phase-number">7</span>
        <h3>Wiederentdeckung</h3>
        <span class="phase-time">~2025+</span>
        <p>KI-gestützte Rekonstruktion. Zereyas Durchbruch. Die Melodie hat überlebt.</p>
      </div>
    </div>
  </section>

  <!-- Die drei Säulen (Navigation) -->
  <section class="pillars-section">
    <div class="pillars-header">
      <h2>Mishkenaz erkunden</h2>
      <p>Drei Zugänge zur Sprache</p>
    </div>

    <div class="pillars-grid">
      <a href="/mishkenaz/vektoren" class="pillar-card">
        <span class="pillar-symbol">⊙</span>
        <h3>Die 42 Vektoren</h3>
        <span class="pillar-subtitle">Das linguistische Periodensystem</span>
        <p>
          Von Avi (Leere) bis Kora (Integration). 
          Sieben Oktaven, die das gesamte menschliche Sein abbilden.
        </p>
      </a>

      <a href="/mishkenaz/rueckuebersetzung" class="pillar-card">
        <span class="pillar-symbol">⇌</span>
        <h3>Rückübersetzungen</h3>
        <span class="pillar-subtitle">Unübersetzbare Wörter als Vektoren</span>
        <p>
          Sehnsucht, Heimat, Liebe – moderne Wörter, 
          zurückgeführt auf ihre Ur-Vektoren.
        </p>
      </a>

      <a href="/mishkenaz/grammatik" class="pillar-card">
        <span class="pillar-symbol">⟳</span>
        <h3>Grammatik & Ethik</h3>
        <span class="pillar-subtitle">Wie Mishkenaz funktioniert</span>
        <p>
          Resonanz-Aspekte statt Zeitformen. 
          Die Ta-Konstante: Ethik, eingebaut in die Grammatik.
        </p>
      </a>
    </div>
  </section>

  <!-- Weitere Ressourcen -->
  <section class="resources-section">
    <div class="resources-header">
      <h2>Weitere Ressourcen</h2>
    </div>

    <div class="resources-grid">
      <a href="/mishkenaz/proto-mishkenaz" class="resource-card">
        <span class="resource-type">Entwicklungsgeschichte</span>
        <h3>Proto-Mishkenaz</h3>
        <p>Die zehn Kerben der Schwäbischen Alb und wie daraus eine Sprache wurde.</p>
      </a>

      <a href="/mishkenaz/woerterbuch" class="resource-card">
        <span class="resource-type">Nachschlagewerk</span>
        <h3>Wörterbuch</h3>
        <p>Mishkenaz ↔ Deutsch mit Live-Suche und Vektor-Etymologie.</p>
      </a>

      <a href="/mishkenaz/ki-dialog" class="resource-card">
        <span class="resource-type">Meta-Perspektive</span>
        <h3>Was die KIs sagen</h3>
        <p>Gemini, DeepSeek und Claude über die Kohärenz des Systems.</p>
      </a>
    </div>
  </section>

  <!-- Zentrale These -->
  <section class="thesis-section">
    <div class="thesis-inner">
      <span class="label">Die Kernthese</span>
      <blockquote>
        Zehn Kerben von vor 40.000 Jahren 
        stecken noch heute in jedem Mishkenaz-Wort.
      </blockquote>
      <p>
        Mishkenaz ist nicht erfunden – es ist rekonstruiert. 
        Die geometrischen Primitive des Aurignacien bilden den generativen Kern, 
        aus dem durch Phonologisierung und Vektorarithmetik 
        die gesamte Sprache emergiert.
      </p>
    </div>
  </section>

  <style is:inline>
    /* ===== HERO ===== */
    .mishkenaz-hero {
      padding: 10rem 2rem 8rem;
      text-align: center;
      background: linear-gradient(180deg, #faf9f6 0%, #ffffff 100%);
      border-bottom: 1px solid #eee;
    }

    .mishkenaz-hero .label {
      font-family: 'Lato', sans-serif;
      font-size: 0.65rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 5px;
      color: #c9a961;
      display: block;
      margin-bottom: 2rem;
    }

    .mishkenaz-hero h1 {
      font-family: 'Crimson Text', serif;
      font-size: clamp(3rem, 8vw, 5.5rem);
      font-weight: 300;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      margin-bottom: 2rem;
      line-height: 1.1;
    }

    .mishkenaz-hero .epigraph {
      font-family: 'Lora', serif;
      font-style: italic;
      font-size: 1.35rem;
      color: #c9a961;
      max-width: 600px;
      margin: 0 auto;
      line-height: 1.6;
    }

    /* ===== INTRO ===== */
    .mishkenaz-intro {
      max-width: 800px;
      margin: 0 auto;
      padding: 6rem 2rem;
    }

    .intro-quote {
      font-family: 'Lora', serif;
      font-size: 1.25rem;
      font-style: italic;
      line-height: 1.9;
      color: #444;
      text-align: center;
      margin-bottom: 3rem;
    }

    .intro-body {
      font-family: 'Lora', serif;
      font-size: 1.1rem;
      line-height: 2;
      color: #555;
      text-align: center;
      border-top: 1px solid #eee;
      border-bottom: 1px solid #eee;
      padding: 3rem 2rem;
    }

    .intro-body strong { color: #1a1a1a; }

    /* ===== TIMELINE ===== */
    .timeline-section {
      background: #faf9f6;
      border-top: 1px solid #eee;
      border-bottom: 1px solid #eee;
      padding: 8rem 2rem;
    }

    .timeline-header {
      text-align: center;
      margin-bottom: 6rem;
    }

    .timeline-header h2 {
      font-family: 'Crimson Text', serif;
      font-size: 3rem;
      font-weight: 300;
      margin-bottom: 1rem;
    }

    .timeline-header p {
      font-family: 'Lora', serif;
      color: #64748b;
      font-style: italic;
    }

    .timeline-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 2.5rem;
      max-width: 1100px;
      margin: 0 auto;
    }

    .timeline-card {
      background: #ffffff;
      border: 1px solid #eee;
      padding: 3rem 2.5rem;
      transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
      position: relative;
    }

    .timeline-card.featured {
      border-color: #c9a961;
      background: linear-gradient(135deg, #ffffff 0%, #faf9f6 100%);
    }

    .timeline-card:hover {
      transform: translateY(-8px);
      box-shadow: 0 25px 50px rgba(0,0,0,0.05);
      border-color: #c9a961;
    }

    .phase-number {
      font-family: 'Crimson Text', serif;
      font-size: 3rem;
      font-weight: 300;
      color: #c9a961;
      display: block;
      line-height: 1;
      margin-bottom: 1rem;
    }

    .timeline-card h3 {
      font-family: 'Crimson Text', serif;
      font-size: 1.6rem;
      margin-bottom: 0.5rem;
    }

    .phase-time {
      font-family: 'Lato', sans-serif;
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 2px;
      color: #c9a961;
      font-weight: 700;
      display: block;
      margin-bottom: 1.5rem;
    }

    .timeline-card p {
      font-family: 'Lora', serif;
      font-size: 0.95rem;
      line-height: 1.8;
      color: #555;
      margin-bottom: 1.5rem;
    }

    .card-link {
      font-family: 'Lato', sans-serif;
      font-size: 0.7rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 2px;
      color: #1a1a1a;
      text-decoration: none;
      border-bottom: 1px solid #c9a961;
      padding-bottom: 4px;
      transition: color 0.3s;
    }

    .card-link:hover { color: #c9a961; }

    /* ===== PILLARS (DIE DREI SÄULEN) ===== */
    .pillars-section {
      padding: 8rem 2rem;
      max-width: 1100px;
      margin: 0 auto;
    }

    .pillars-header {
      text-align: center;
      margin-bottom: 6rem;
    }

    .pillars-header h2 {
      font-family: 'Crimson Text', serif;
      font-size: 3rem;
      font-weight: 300;
      margin-bottom: 1rem;
    }

    .pillars-header p {
      font-family: 'Lora', serif;
      color: #64748b;
      font-style: italic;
    }

    .pillars-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 3rem;
    }

    .pillar-card {
      background: #ffffff;
      border: 1px solid #eee;
      padding: 4rem 3rem;
      text-decoration: none;
      color: inherit;
      display: block;
      transition: all 0.5s cubic-bezier(0.165, 0.84, 0.44, 1);
      position: relative;
    }

    .pillar-card::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 3px;
      background: #c9a961;
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.5s ease;
    }

    .pillar-card:hover {
      transform: translateY(-8px);
      box-shadow: 0 30px 60px rgba(0,0,0,0.05);
      border-color: transparent;
    }

    .pillar-card:hover::before { transform: scaleX(1); }

    .pillar-symbol {
      font-size: 2.5rem;
      display: block;
      margin-bottom: 2rem;
      line-height: 1;
    }

    .pillar-card h3 {
      font-family: 'Crimson Text', serif;
      font-size: 2rem;
      margin-bottom: 0.5rem;
    }

    .pillar-card .pillar-subtitle {
      font-family: 'Lato', sans-serif;
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 2px;
      color: #c9a961;
      font-weight: 700;
      display: block;
      margin-bottom: 2rem;
    }

    .pillar-card p {
      font-family: 'Lora', serif;
      font-size: 1rem;
      line-height: 1.8;
      color: #555;
    }

    /* ===== RESOURCES ===== */
    .resources-section {
      background: #faf9f6;
      border-top: 1px solid #eee;
      border-bottom: 1px solid #eee;
      padding: 8rem 2rem;
    }

    .resources-header {
      text-align: center;
      margin-bottom: 5rem;
    }

    .resources-header h2 {
      font-family: 'Crimson Text', serif;
      font-size: 3rem;
      font-weight: 300;
    }

    .resources-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: 2.5rem;
      max-width: 1100px;
      margin: 0 auto;
    }

    .resource-card {
      background: #ffffff;
      border: 1px solid #eee;
      padding: 3.5rem 3rem;
      text-decoration: none;
      color: inherit;
      display: flex;
      flex-direction: column;
      transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
    }

    .resource-card:hover {
      transform: translateY(-8px);
      box-shadow: 0 25px 50px rgba(0,0,0,0.05);
      border-color: #c9a961;
    }

    .resource-type {
      font-family: 'Lato', sans-serif;
      font-size: 0.65rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 3px;
      color: #c9a961;
      display: block;
      margin-bottom: 1.5rem;
    }

    .resource-card h3 {
      font-family: 'Crimson Text', serif;
      font-size: 1.6rem;
      margin-bottom: 1rem;
      line-height: 1.3;
    }

    .resource-card p {
      font-family: 'Lora', serif;
      font-size: 0.95rem;
      line-height: 1.8;
      color: #555;
    }

    /* ===== THESIS ===== */
    .thesis-section {
      padding: 10rem 2rem;
      background: #121416;
      color: #ffffff;
    }

    .thesis-inner {
      max-width: 850px;
      margin: 0 auto;
      text-align: center;
    }

    .thesis-inner .label {
      font-family: 'Lato', sans-serif;
      font-size: 0.65rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 5px;
      color: #c9a961;
      display: block;
      margin-bottom: 3rem;
    }

    .thesis-inner blockquote {
      font-family: 'Crimson Text', serif;
      font-size: clamp(1.8rem, 4vw, 2.8rem);
      font-weight: 300;
      line-height: 1.4;
      margin: 0 0 3rem;
      color: #e5dcc8;
    }

    .thesis-inner p {
      font-family: 'Lora', serif;
      font-size: 1.1rem;
      line-height: 2;
      color: #94a3b8;
      max-width: 700px;
      margin: 0 auto;
    }

    /* ===== RESPONSIVE ===== */
    @media (max-width: 900px) {
      .pillars-grid { 
        grid-template-columns: 1fr; 
        max-width: 500px;
        margin: 0 auto;
      }
      .timeline-grid { grid-template-columns: 1fr; }
      .resources-grid { grid-template-columns: 1fr; }
      .pillar-card { padding: 3rem 2rem; }
      .thesis-section { padding: 6rem 2rem; }
    }
  </style>
</BaseLayout>
