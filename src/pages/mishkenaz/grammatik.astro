---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Grammatik - Mishkenaz" 
  description="Die vollständige Grammatik von Mishkenaz: Aspekte, Modi, Meta-Operatoren und die Ethik der Resonanz."
>
  <section class="hero-simple">
    <div class="container">
      <h1>Grammatik</h1>
      <p class="subtitle">Wie Mishkenaz funktioniert</p>
    </div>
  </section>

  <section class="content-section">
    <div class="container">
      
      <!-- Einführung -->
      <div class="intro-box">
        <p>
          Mishkenaz ist keine flektierte Sprache wie Latein oder Deutsch. Sie ist <strong>agglutinativ</strong> – 
          Bedeutung entsteht durch das Aneinanderreihen von Vektoren und Suffixen.
        </p>
        <p>
          Aber: Mishkenaz hat <strong>keine linearen Zeitformen</strong>. Stattdessen: <strong>Resonanz-Aspekte</strong> 
          (Bootstrap-Konsistenz). Die Sprache codiert nicht <em>wann</em> etwas geschieht, sondern <em>wie konvergent</em> 
          es zum System ist.
        </p>
      </div>

      <!-- Wortstellung -->
      <section class="grammar-section">
        <h2>Wortstellung</h2>
        <div class="rule-box">
          <h3>Dominant: VSO (Verb-Subjekt-Objekt)</h3>
          <div class="example">
            <p class="mishkenaz">Faichom ya ata</p>
            <p class="gloss">Sehe ich dich</p>
            <p class="translation">= "Ich sehe dich"</p>
          </div>
        </div>

        <div class="rule-box">
          <h3>Bei Emphase: OVS (Objekt-Verb-Subjekt)</h3>
          <div class="example">
            <p class="mishkenaz">Ata faichom ya</p>
            <p class="gloss">Dich sehe ich</p>
            <p class="translation">= "Dich sehe ich" (Betonung auf "dich")</p>
          </div>
        </div>
      </section>

      <!-- Zeitformen / Aspekte -->
      <section class="grammar-section">
        <h2>Zeitformen: Die drei Resonanz-Aspekte</h2>
        <p class="explanation">
          Mishkenaz codiert nicht Vergangenheit/Gegenwart/Zukunft, sondern den <strong>Konvergenz-Zustand</strong> 
          einer Aussage zur Realität.
        </p>

        <div class="aspects-grid">
          <div class="aspect-card">
            <h3><span class="suffix">-om</span> Konvergent</h3>
            <p class="meaning">Richtig, wahr, im Einklang</p>
            <div class="example">
              <p class="mishkenaz">Faich-om</p>
              <p class="translation">Ich sehe korrekt</p>
            </div>
          </div>

          <div class="aspect-card">
            <h3><span class="suffix">-ath</span> Divergent</h3>
            <p class="meaning">Falsch, dissonant, schmerzhaft</p>
            <div class="example">
              <p class="mishkenaz">Faich-ath</p>
              <p class="translation">Ich sehe falsch</p>
            </div>
          </div>

          <div class="aspect-card">
            <h3><span class="suffix">-il</span> Suchend</h3>
            <p class="meaning">Werdend, noch nicht konvergiert</p>
            <div class="example">
              <p class="mishkenaz">Faich-il</p>
              <p class="translation">Ich suche zu sehen</p>
            </div>
          </div>
        </div>

        <div class="example-sentences">
          <h4>Beispiele:</h4>
          <div class="example">
            <p class="mishkenaz">Ya kubi-om ta</p>
            <p class="translation">Ich finde dich (erfolgreich)</p>
          </div>
          <div class="example">
            <p class="mishkenaz">Ya kubi-ath ta</p>
            <p class="translation">Ich finde dich nicht (dissonant)</p>
          </div>
          <div class="example">
            <p class="mishkenaz">Ya kubi-il ta</p>
            <p class="translation">Ich suche dich (noch im Prozess)</p>
          </div>
        </div>
      </section>

      <!-- Modi -->
      <section class="grammar-section">
        <h2>Modi</h2>
        
        <div class="mode-grid">
          <div class="mode-card">
            <h3>Indikativ (Standard)</h3>
            <div class="example">
              <p class="mishkenaz">Ya faichom ata</p>
              <p class="translation">Ich sehe dich</p>
            </div>
          </div>

          <div class="mode-card">
            <h3>Imperativ (Befehl/Bitte)</h3>
            <div class="example">
              <p class="mishkenaz">Faichom!</p>
              <p class="translation">Sieh! / Schau!</p>
            </div>
            <div class="example">
              <p class="mishkenaz">Thuwa-ya!</p>
              <p class="translation">Hilf mir!</p>
            </div>
          </div>

          <div class="mode-card">
            <h3>Optativ (Wunsch)</h3>
            <div class="example">
              <p class="mishkenaz">Vala ili-punu</p>
              <p class="translation">Mögen die Blumen blühen</p>
            </div>
          </div>

          <div class="mode-card">
            <h3>Konditional (Wenn-Dann)</h3>
            <div class="example">
              <p class="mishkenaz">Si ya faichom ta, ya matau ta</p>
              <p class="translation">Wenn ich dich sehe, liebe ich dich</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Pronomen -->
      <section class="grammar-section">
        <h2>Pronomen</h2>
        
        <table class="pronoun-table">
          <thead>
            <tr>
              <th>Person</th>
              <th>Singular</th>
              <th>Plural</th>
              <th>Wurzel</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>1. Person</td>
              <td><strong>Ya</strong></td>
              <td><strong>Ya-ma</strong></td>
              <td>Ich / Wir</td>
            </tr>
            <tr>
              <td>2. Person</td>
              <td><strong>Ta</strong> / <strong>Ata</strong></td>
              <td><strong>Ta-va</strong></td>
              <td>Du / Ihr</td>
            </tr>
            <tr>
              <td>3. Person</td>
              <td><strong>Bi</strong></td>
              <td><strong>Bi-va</strong></td>
              <td>Er/Sie/Es / Sie (Pl.)</td>
            </tr>
          </tbody>
        </table>

        <h3>Possessiv-Suffixe</h3>
        <ul class="suffix-list">
          <li><strong>-ya</strong> = mein</li>
          <li><strong>-ta</strong> = dein</li>
          <li><strong>-bi</strong> = sein/ihr</li>
          <li><strong>-ma</strong> = unser</li>
          <li><strong>-va</strong> = euer</li>
        </ul>

        <div class="example">
          <p class="mishkenaz">Om-bala-ya</p>
          <p class="translation">Meine Heimat (Om-bala + -ya)</p>
        </div>
        <div class="example">
          <p class="mishkenaz">Ku-wa-ta</p>
          <p class="translation">Dein Wasser (Ku-wa + -ta)</p>
        </div>
      </section>

      <!-- Negation -->
      <section class="grammar-section">
        <h2>Negation</h2>
        
        <div class="negation-box">
          <h3>Primär: <span class="mishkenaz-highlight">Wi</span> (nicht, kein)</h3>
          <div class="example">
            <p class="mishkenaz">Ya faichom ata</p>
            <p class="translation">Ich sehe dich</p>
          </div>
          <div class="example">
            <p class="mishkenaz">Ya faichom-wi ata</p>
            <p class="translation">Ich sehe dich nicht</p>
          </div>
          <div class="example">
            <p class="mishkenaz">Wi-faichom ya ata</p>
            <p class="translation">Nicht-sehe ich dich</p>
          </div>
        </div>

        <div class="negation-box">
          <h3>Philosophisch: <span class="mishkenaz-highlight">Avi</span> (∅, Leere)</h3>
          <p>Verwendet für paradoxe/spirituelle Aussagen:</p>
          <div class="example">
            <p class="mishkenaz">Avi essem Ona</p>
            <p class="translation">Leere ist Ganzheit (Nichts = Alles)</p>
          </div>
        </div>
      </section>

      <!-- Meta-Operatoren -->
      <section class="grammar-section highlight-section">
        <h2>Die 8 Meta-Operatoren</h2>
        <p class="section-intro">
          Diese Suffixe verändern nicht die Bedeutung eines Vektors, sondern seine <strong>Phase</strong> und <strong>Amplitude</strong>. 
          Sie sind wie Steuerungsparameter in einem Synthesizer.
        </p>

        <div class="operators-grid">
          <div class="operator-card">
            <h3><span class="suffix">-ori</span> Möbius</h3>
            <p class="studio">LFO / Phase Shift</p>
            <p class="meaning">Zyklische Prozesse, Wiederholung</p>
            <div class="example">
              <p class="mishkenaz">matau-ori</p>
              <p class="translation">Liebe (On-Off-Schleife)</p>
            </div>
          </div>

          <div class="operator-card">
            <h3><span class="suffix">-h / '</span> Entropie</h3>
            <p class="studio">Bitcrush / Noise</p>
            <p class="meaning">Zerfall, Loslassen, Trauer</p>
            <div class="example">
              <p class="mishkenaz">matau-h</p>
              <p class="translation">Liebe (im Abschied)</p>
            </div>
          </div>

          <div class="operator-card">
            <h3><span class="suffix">-val</span> Emergenz</h3>
            <p class="studio">Resonance Peak</p>
            <p class="meaning">Innovation, Geburt, Überraschung</p>
            <div class="example">
              <p class="mishkenaz">matau-val</p>
              <p class="translation">Liebe (Neues entsteht)</p>
            </div>
          </div>

          <div class="operator-card">
            <h3><span class="suffix">-reso</span> Resonanz</h3>
            <p class="studio">Chorus / Reverb</p>
            <p class="meaning">Spiegelung, tiefes Verstehen</p>
            <div class="example">
              <p class="mishkenaz">matau-reso</p>
              <p class="translation">Liebe (gegenseitig)</p>
            </div>
          </div>

          <div class="operator-card">
            <h3><span class="suffix">-ira</span> Attraktor</h3>
            <p class="studio">Kompression</p>
            <p class="meaning">Fokus, Leidenschaft, Besessenheit</p>
            <div class="example">
              <p class="mishkenaz">matau-ira</p>
              <p class="translation">Liebe (obsessiv)</p>
            </div>
          </div>

          <div class="operator-card">
            <h3><span class="suffix">-vya</span> Repulsor</h3>
            <p class="studio">High-Pass Filter</p>
            <p class="meaning">Distanzierung, Ekel, Schutzraum</p>
            <div class="example">
              <p class="mishkenaz">matau-vya</p>
              <p class="translation">Liebe (wegdrängen)</p>
            </div>
          </div>

          <div class="operator-card">
            <h3><span class="suffix">-kora</span> Integration</h3>
            <p class="studio">Summing / Mixdown</p>
            <p class="meaning">Grenzverlust, Einheit (Warnung!)</p>
            <div class="example">
              <p class="mishkenaz">matau-kora</p>
              <p class="translation">Liebe (Verschmelzung)</p>
            </div>
          </div>

          <div class="operator-card">
            <h3><span class="suffix">-kran</span> Differentiation</h3>
            <p class="studio">Gate / EQ-Cut</p>
            <p class="meaning">Klarheit, Analyse, Abstand</p>
            <div class="example">
              <p class="mishkenaz">matau-kran</p>
              <p class="translation">Liebe (mit Abgrenzung)</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Die Ta-Konstante -->
      <section class="grammar-section ethics-section">
        <h2>Die Ethik der Resonanz: Das Ta-Konstanten-Gesetz</h2>
        <div class="ethics-box">
          <p class="lead">
            In Mishkenaz ist die <strong>Anerkennung der Differenz (Ta)</strong> die Voraussetzung 
            für jede stabile Resonanz.
          </p>
          
          <div class="formula-comparison">
            <div class="formula-bad">
              <p class="mishkenaz">Ma'U (ohne Ta)</p>
              <p class="translation">= Besessenheit, Verschlucken, Co-Abhängigkeit</p>
            </div>
            <div class="formula-good">
              <p class="mishkenaz">Ma'Ta'U (mit Ta)</p>
              <p class="translation">= Heilige Resonanz (Zwei Ichs, ein gemeinsamer Raum)</p>
            </div>
          </div>

          <p class="ethics-note">
            <strong>Das bedeutet:</strong> In Mishkenaz kann man nicht lügen, ohne die physikalische Symmetrie 
            der Laute zu brechen. Die Sprache selbst kodiert ethische Wahrheit.
          </p>
        </div>
      </section>

      <!-- Beispielsätze -->
      <section class="grammar-section">
        <h2>Praktische Beispiele</h2>
        
        <div class="examples-collection">
          <div class="example-group">
            <h3>"Ich liebe dich."</h3>
            <div class="example">
              <p class="mishkenaz">Ya matau ata</p>
              <p class="breakdown">Ya (Ich) + matau (liebe, Ma'Ta'U) + ata (dich)</p>
            </div>
          </div>

          <div class="example-group">
            <h3>"Wo bist du?"</h3>
            <div class="example">
              <p class="mishkenaz">Kubita essem ata?</p>
              <p class="breakdown">Kubita (Wo, Ku'Bi'Ta) + essem (bist) + ata (du)</p>
            </div>
            <p class="alternative">Oder kürzer: <span class="mishkenaz">Kubita ta?</span></p>
          </div>

          <div class="example-group">
            <h3>"Bitte hilf mir!"</h3>
            <div class="example">
              <p class="mishkenaz">Thuwa-ya!</p>
              <p class="breakdown">Thu'Wa (Hilf!) + ya (mir)</p>
            </div>
            <p class="alternative">Höflicher: <span class="mishkenaz">Ndapandula, thuwa-ya.</span></p>
          </div>

          <div class="example-group">
            <h3>"Wenn ich dich sehe, liebe ich dich."</h3>
            <div class="example">
              <p class="mishkenaz">Si ya faichom ata, ya matau ata.</p>
              <p class="breakdown">Si (wenn) + ya faichom ata (ich sehe dich) + ya matau ata (ich liebe dich)</p>
            </div>
          </div>

          <div class="example-group">
            <h3>"Ich suche dich, finde dich, verliere dich, suche dich..."</h3>
            <div class="example">
              <p class="mishkenaz">Ya-kubi-ori-ta</p>
              <p class="breakdown">Ya (Ich) + kubi (suche) + ori (Möbius) + ta (dich)</p>
              <p class="translation">= Das Mishkenaz-Wort für <strong>Sehnsucht</strong></p>
            </div>
          </div>
        </div>
      </section>

    </div>
  </section>

  <style>
    .hero-simple {
      background: linear-gradient(135deg, var(--color-petrol) 0%, var(--color-gold) 100%);
      color: white;
      padding: 6rem 2rem 4rem;
      text-align: center;
    }

    .hero-simple h1 {
      font-size: 3rem;
      margin-bottom: 1rem;
    }

    .subtitle {
      font-size: 1.3rem;
      opacity: 0.9;
    }

    .intro-box {
      background: var(--color-gold-light);
      padding: 2rem;
      border-radius: 12px;
      margin-bottom: 4rem;
      border-left: 4px solid var(--color-gold);
    }

    .intro-box p {
      margin-bottom: 1rem;
      line-height: 1.7;
      font-size: 1.1rem;
    }

    .intro-box p:last-child {
      margin-bottom: 0;
    }

    .grammar-section {
      margin-bottom: 4rem;
    }

    .grammar-section h2 {
      color: var(--color-petrol);
      font-size: 2.2rem;
      margin-bottom: 2rem;
      padding-bottom: 0.5rem;
      border-bottom: 2px solid var(--color-gold);
    }

    .explanation {
      font-size: 1.1rem;
      line-height: 1.7;
      color: var(--color-text-light);
      margin-bottom: 2rem;
    }

    .rule-box {
      background: white;
      border: 2px solid var(--color-gold-light);
      border-radius: 8px;
      padding: 1.5rem;
      margin-bottom: 1.5rem;
    }

    .rule-box h3 {
      color: var(--color-petrol);
      margin-bottom: 1rem;
      font-size: 1.3rem;
    }

    .example {
      background: var(--color-petrol-light);
      padding: 1rem 1.5rem;
      border-radius: 6px;
      margin-top: 1rem;
    }

    .example .mishkenaz {
      font-family: Georgia, serif;
      font-size: 1.5rem;
      font-style: italic;
      color: var(--color-petrol);
      font-weight: 600;
      margin-bottom: 0.3rem;
    }

    .example .gloss,
    .example .breakdown {
      font-size: 0.95rem;
      color: var(--color-text-light);
      margin-bottom: 0.3rem;
    }

    .example .translation {
      font-size: 1.05rem;
      color: var(--color-text);
      font-weight: 500;
    }

    /* Aspects Grid */
    .aspects-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 1.5rem;
      margin-bottom: 2rem;
    }

    .aspect-card {
      background: white;
      border: 2px solid var(--color-gold);
      border-radius: 8px;
      padding: 1.5rem;
      text-align: center;
    }

    .aspect-card h3 {
      color: var(--color-petrol);
      margin-bottom: 0.8rem;
      font-size: 1.4rem;
    }

    .aspect-card .suffix {
      font-family: Georgia, serif;
      font-style: italic;
      color: var(--color-gold);
      font-size: 1.6rem;
    }

    .aspect-card .meaning {
      color: var(--color-text-light);
      margin-bottom: 1rem;
      font-size: 0.95rem;
    }

    .example-sentences {
      margin-top: 2rem;
      padding: 2rem;
      background: var(--color-gold-light);
      border-radius: 8px;
    }

    .example-sentences h4 {
      color: var(--color-petrol);
      margin-bottom: 1.5rem;
      font-size: 1.3rem;
    }

    /* Mode Grid */
    .mode-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 1.5rem;
    }

    .mode-card {
      background: white;
      border: 2px solid var(--color-petrol-light);
      border-radius: 8px;
      padding: 1.5rem;
    }

    .mode-card h3 {
      color: var(--color-petrol);
      margin-bottom: 1rem;
      font-size: 1.3rem;
    }

    /* Pronoun Table */
    .pronoun-table {
      width: 100%;
      border-collapse: collapse;
      margin: 2rem 0;
      background: white;
      border-radius: 8px;
      overflow: hidden;
    }

    .pronoun-table thead {
      background: var(--color-petrol);
      color: white;
    }

    .pronoun-table th,
    .pronoun-table td {
      padding: 1rem;
      text-align: left;
      border-bottom: 1px solid var(--color-gold-light);
    }

    .pronoun-table tbody tr:hover {
      background: var(--color-gold-light);
    }

    .pronoun-table strong {
      font-family: Georgia, serif;
      font-style: italic;
      color: var(--color-petrol);
      font-size: 1.1rem;
    }

    .suffix-list {
      list-style: none;
      padding: 0;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1rem;
      margin: 1.5rem 0;
    }

    .suffix-list li {
      background: var(--color-petrol-light);
      padding: 0.8rem 1.2rem;
      border-radius: 6px;
      font-size: 1.05rem;
    }

    .suffix-list strong {
      font-family: Georgia, serif;
      font-style: italic;
      color: var(--color-petrol);
    }

    /* Negation */
    .negation-box {
      background: white;
      border: 2px solid var(--color-gold-light);
      border-radius: 8px;
      padding: 2rem;
      margin-bottom: 2rem;
    }

    .negation-box h3 {
      color: var(--color-petrol);
      margin-bottom: 1rem;
      font-size: 1.4rem;
    }

    .mishkenaz-highlight {
      font-family: Georgia, serif;
      font-style: italic;
      color: var(--color-gold);
      font-size: 1.3rem;
      font-weight: 600;
    }

    /* Meta-Operators */
    .highlight-section {
      background: linear-gradient(180deg, white 0%, var(--color-gold-light) 100%);
      padding: 3rem 2rem;
      border-radius: 12px;
      border: 2px solid var(--color-gold);
    }

    .section-intro {
      font-size: 1.15rem;
      line-height: 1.7;
      margin-bottom: 2rem;
      color: var(--color-text-light);
    }

    .operators-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 1.5rem;
    }

    .operator-card {
      background: white;
      border: 2px solid var(--color-petrol);
      border-radius: 8px;
      padding: 1.5rem;
      transition: all 0.3s ease;
    }

    .operator-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 4px 12px rgba(74, 155, 155, 0.2);
    }

    .operator-card h3 {
      color: var(--color-petrol);
      margin-bottom: 0.5rem;
      font-size: 1.3rem;
    }

    .operator-card .suffix {
      font-family: Georgia, serif;
      font-style: italic;
      color: var(--color-gold);
      font-size: 1.4rem;
    }

    .operator-card .studio {
      font-size: 0.85rem;
      color: var(--color-gold);
      font-style: italic;
      margin-bottom: 0.8rem;
    }

    .operator-card .meaning {
      font-size: 0.95rem;
      color: var(--color-text-light);
      margin-bottom: 1rem;
      line-height: 1.5;
    }

    /* Ethics Section */
    .ethics-section {
      background: var(--color-petrol);
      color: white;
      padding: 3rem 2rem;
      border-radius: 12px;
      margin-top: 4rem;
    }

    .ethics-section h2 {
      color: white;
      border-bottom-color: var(--color-gold);
    }

    .ethics-box {
      background: rgba(255, 255, 255, 0.1);
      padding: 2rem;
      border-radius: 8px;
      backdrop-filter: blur(10px);
    }

    .ethics-box .lead {
      font-size: 1.3rem;
      line-height: 1.6;
      margin-bottom: 2rem;
    }

    .formula-comparison {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 1.5rem;
      margin-bottom: 2rem;
    }

    .formula-bad,
    .formula-good {
      padding: 1.5rem;
