---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Mishkenaz — Grammatik" description="Die linguistische Vertiefung zu Mishkenaz wird auf mishkenaz.org gepflegt.">
  <section class="container" style="max-width:820px;padding:8rem 2rem;">
    <p style="font-family:'Lato',sans-serif;text-transform:uppercase;letter-spacing:.2em;color:var(--gold);font-size:.7rem;">Mishkenaz · Vertiefung</p>
    <h1 style="font-family:'Crimson Text',serif;font-size:3rem;margin:1rem 0 2rem;">Grammatik</h1>
    <p style="font-family:'Lora',serif;font-size:1.1rem;line-height:1.9;">Die vollständige grammatische Ausarbeitung wird nicht mehr parallel auf der Autorenseite gepflegt. Phonologie, Grammatik, Wandelregeln, Lexikon und Varianten liegen im eigenständigen Mishkenaz-Projekt.</p>
    <p style="margin-top:2rem;"><a href="https://mishkenaz.org" style="border-bottom:1px solid var(--gold);text-decoration:none;">Zur linguistischen Vertiefung auf mishkenaz.org →</a></p>
    <p style="margin-top:3rem;"><a href="/mishkenaz">← Zum Mishkenaz-Überblick</a></p>
  </section>
</BaseLayout>
