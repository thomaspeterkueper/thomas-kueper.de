---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const books = await getCollection('romane');
const sortedBooks = books.sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
---
<BaseLayout
  title="Romane"
  description="Romane und literarische Projekte von Thomas Peter Küper."
>
  <style is:inline>
    .archive-container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 8rem 2rem;
    }
    .archive-header {
      text-align: center;
      margin-bottom: 7rem;
    }
    .archive-header h1 {
      font-family: 'Crimson Text', serif;
      font-size: clamp(3rem, 8vw, 4.5rem);
      font-weight: 300;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      margin-bottom: 1.5rem;
      line-height: 1.1;
    }
    .archive-header p {
      font-family: 'Lora', serif;
      font-style: italic;
      color: #c9a961;
      font-size: 1.25rem;
    }

    /* Grid */
    .book-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 4rem 3rem;
    }
    @media (min-width: 700px) {
      .book-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }
    @media (min-width: 1100px) {
      .book-grid {
        grid-template-columns: repeat(3, 1fr);
      }
    }

    /* Karte */
    .book-card {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }
    .cover-box {
      overflow: hidden;
    }
    .cover-box img {
      width: 100%;
      height: auto;
      display: block;
      box-shadow: 0 12px 35px rgba(0,0,0,0.10);
      border: 1px solid #eee;
      border-radius: 2px;
      transition: transform 0.5s ease;
    }
    .book-card:hover .cover-box img {
      transform: translateY(-6px);
    }
    .content-box {
      display: flex;
      flex-direction: column;
      flex: 1;
    }
    .genre-label {
      font-family: 'Lato', sans-serif;
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 3px;
      color: #c9a961;
      font-weight: 700;
      display: block;
      margin-bottom: 0.6rem;
    }
    .content-box h2 {
      font-family: 'Crimson Text', serif;
      font-size: 2rem;
      font-weight: 300;
      margin: 0 0 0.8rem;
      line-height: 1.15;
    }
    .description-text {
      font-family: 'Lora', serif;
      font-size: 0.95rem;
      line-height: 1.8;
      color: #555;
      margin-bottom: 1.5rem;
      flex: 1;
    }
    .details-link {
      font-family: 'Lato', sans-serif;
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 2px;
      color: #1a1a1a;
      text-decoration: none;
      border-bottom: 1px solid #c9a961;
      padding-bottom: 4px;
      transition: opacity 0.3s;
      align-self: flex-start;
    }
    .details-link:hover { opacity: 0.6; }

    @media (max-width: 699px) {
      .book-grid { gap: 5rem; }
      .cover-box { max-width: 260px; margin: 0 auto; }
      .book-card { text-align: center; }
      .details-link { align-self: center; }
    }
  </style>

  <div class="archive-container">
    <header class="archive-header">
      <h1>Romane</h1>
      <p>Fiktion, Resonanz und Weltentwürfe</p>
    </header>

    <div class="book-grid">
      {sortedBooks.map((book) => (
        <article class="book-card">
          <div class="cover-box">
            {book.data.cover ? (
              <img
                src={book.data.cover}
                alt={book.data.title ?? book.slug}
                loading="lazy"
              />
            ) : (
              <div style="aspect-ratio:2/3; background:#faf9f6; border:1px solid #eee;"></div>
            )}
          </div>
          <div class="content-box">
            <span class="genre-label">{book.data.genre ?? 'Roman'}</span>
            <h2>{book.data.title ?? book.slug}</h2>
            {book.data.description
              ? <p class="description-text">{book.data.description}</p>
              : null}
            <a href={`/romane/${book.slug}/`} class="details-link">
              Zur Detailseite →
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>
