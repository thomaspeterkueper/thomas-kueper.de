---
// Dateipfad: src/pages/romane/index.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allRomane = (await getCollection('romane', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);

const universes = [
  { key: 'baumeister', label: 'Baumeister Universe', description: 'Epische Erzählwelt — einschließlich der Zereya Saga.' },
  { key: 'noxia', label: 'noχ¹ა Universe', description: 'GENERATION MARS — YA-Serie in 5 Bänden.' },
  { key: 'standalone', label: 'Standalone', description: 'Eigenständige Werke.' },
];

const statusLabels: Record<string, string> = {
  'veröffentlicht': '✦ Veröffentlicht',
  'in-arbeit': '◐ In Arbeit',
  'geplant': '○ Geplant',
};

// Farben für Platzhalter pro Universe
const placeholderColors: Record<string, { bg: string; accent: string }> = {
  baumeister: { bg: '#1A2A1A', accent: '#C9A961' },
  noxia: { bg: '#1A1A2A', accent: '#4A9B9B' },
  standalone: { bg: '#2A1A1A', accent: '#C41E3A' },
};
---

<BaseLayout title="Romane" description="Die literarischen Welten von Thomas Peter Küper — vom Baumeister Universe über GENERATION MARS bis zu Störsignal.">

  <section class="hero">
    <div class="container">
      <p class="section-label">Literatur</p>
      <h1>Romane & Welten</h1>
      <span class="hero-ornament"></span>
    </div>
  </section>

  {universes.map(uni => {
    const entries = allRomane.filter(e => e.data.universe === uni.key);
    if (entries.length === 0) return null;
    const colors = placeholderColors[uni.key] || placeholderColors.standalone;
    return (
      <section class="section">
        <div class="container">
          <p class="section-label">{uni.label}</p>
          <p style="color: var(--text-muted); margin-bottom: var(--space-xl); max-width: var(--content-width);">{uni.description}</p>
          <div class="card-grid">
            {entries.map(entry => (
              <a href={`/romane/${entry.id}`} class="card book-card">
                <div class="book-cover">
                  {entry.data.coverImage ? (
                    <img src={entry.data.coverImage} alt={`Cover: ${entry.data.title}`} />
                  ) : (
                    <div class="book-cover-placeholder" style={`background: linear-gradient(135deg, ${colors.bg}, ${colors.bg}dd); border-color: ${colors.accent}33;`}>
                      <span class="placeholder-accent" style={`color: ${colors.accent};`}>✦</span>
                      <span class="placeholder-title">{entry.data.title}</span>
                      {entry.data.subtitle && (
                        <span class="placeholder-subtitle">{entry.data.subtitle}</span>
                      )}
                    </div>
                  )}
                </div>
                <div class="book-info">
                  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-sm);">
                    <span class="card-category">{entry.data.genre}</span>
                    <span style="font-size: var(--size-xs); color: var(--text-light);">{statusLabels[entry.data.status]}</span>
                  </div>
                  <h3>{entry.data.title}</h3>
                  {entry.data.subtitle && <p style="font-style: italic; color: var(--petrol); font-size: var(--size-sm);">{entry.data.subtitle}</p>}
                  <p>{entry.data.description}</p>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    );
  })}

</BaseLayout>

<style>
  .book-card {
    padding: 0;
    overflow: hidden;
  }

  .book-cover {
    width: 100%;
    aspect-ratio: 2 / 3;
    overflow: hidden;
  }

  .book-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition);
  }

  .book-card:hover .book-cover img {
    transform: scale(1.03);
  }

  .book-cover-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 2rem;
    text-align: center;
    border-bottom: 1px solid;
    position: relative;
    overflow: hidden;
  }

  .book-cover-placeholder::before {
    content: '';
    position: absolute;
    inset: 0;
    background: 
      radial-gradient(ellipse at 30% 20%, rgba(255,255,255,0.03) 0%, transparent 60%),
      radial-gradient(ellipse at 70% 80%, rgba(255,255,255,0.02) 0%, transparent 50%);
  }

  .placeholder-accent {
    font-size: 1.5rem;
    opacity: 0.6;
  }

  .placeholder-title {
    font-family: var(--font-heading);
    font-size: var(--size-2xl);
    font-weight: 700;
    color: #E8E8E8;
    letter-spacing: -0.01em;
    line-height: 1.2;
    position: relative;
  }

  .placeholder-subtitle {
    font-family: var(--font-heading);
    font-size: var(--size-sm);
    font-style: italic;
    color: #999;
    line-height: 1.4;
    max-width: 80%;
    position: relative;
  }

  .book-info {
    padding: var(--space-xl);
  }

  .book-info h3 {
    font-size: var(--size-xl);
    margin-bottom: var(--space-sm);
  }

  .book-info p {
    color: var(--text-muted);
    font-size: var(--size-sm);
    margin-bottom: 0;
  }
</style>
