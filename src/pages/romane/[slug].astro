---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
export async function getStaticPaths() {
  const romane = await getCollection('romane');
  return romane.map((r) => ({
    params: { slug: r.slug },
    props: { roman: r },
  }));
}
const { roman } = Astro.props;
const { Content } = await roman.render();
---
<BaseLayout title={`${roman.data.title} — Roman von Thomas Peter Küper`} description={roman.data.description ?? ''}>
  <style>
    .book-page {
      max-width: 950px;
      margin: 0 auto;
      padding: 6rem 2rem;
      color: #1a1a1a;
      font-family: 'Lora', serif;
      line-height: 1.9;
    }

    /* Hero */
    .hero-split {
      display: grid;
      grid-template-columns: 280px 1fr;
      gap: 5rem;
      align-items: start;
      margin-bottom: 6rem;
    }
    .cover-sticky {
      position: sticky;
      top: 120px;
    }
    .book-cover {
      width: 100%;
      height: auto;
      border-radius: 2px;
      box-shadow: 0 30px 60px rgba(0,0,0,0.12);
      border: 1px solid #f0f0f0;
    }
    .meta {
      font-family: 'Lato', sans-serif;
      text-transform: uppercase;
      letter-spacing: 3px;
      font-size: 0.7rem;
      color: #c9a961;
      display: block;
      margin-bottom: 1rem;
      font-weight: 700;
    }
    h1 {
      font-family: 'Crimson Text', serif;
      font-size: clamp(2rem, 5vw, 3.2rem);
      text-transform: uppercase;
      letter-spacing: 0.1em;
      margin: 0 0 1rem;
      font-weight: 300;
      line-height: 1.1;
    }
    .tagline {
      font-size: 1.1rem;
      color: #888;
      font-style: italic;
      display: block;
      line-height: 1.6;
    }

    /* Content */
    .main-content {
      padding-top: 1rem;
    }

    .main-content h2 {
      font-family: 'Crimson Text', serif;
      font-size: 2rem;
      font-weight: 300;
      margin: 4.5rem 0 1.2rem;
      letter-spacing: 0.05em;
      line-height: 1.2;
      color: #1a1a1a;
    }

    .main-content h3 {
      font-family: 'Lato', sans-serif;
      font-size: 0.72rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 3px;
      color: #c9a961;
      margin: 3rem 0 0.8rem;
    }

    .main-content p {
      font-size: 1.05rem;
      line-height: 2;
      color: #3a3a3a;
      margin-bottom: 2rem;
      max-width: 680px;
    }

    .main-content blockquote {
      border-left: 2px solid #c9a961;
      margin: 3.5rem 0;
      padding: 0.25rem 0 0.25rem 2rem;
      font-style: italic;
      color: #c9a961;
      font-size: 1.1rem;
      line-height: 1.85;
    }

    .main-content blockquote p {
      margin-bottom: 0;
      color: #c9a961;
    }

    /* HR dezent statt störend */
    .main-content hr {
      border: none;
      border-top: 1px solid #f0ede8;
      margin: 3.5rem 0;
      max-width: 120px;
    }

    /* Custom Audio Player */
    .main-content audio {
      display: none;
    }

    .audio-wrapper {
      background: #faf8f4;
      border: 1px solid #ede9e2;
      border-radius: 4px;
      padding: 1.5rem 2rem;
      margin: 2rem 0 1rem;
      display: flex;
      align-items: center;
      gap: 1.5rem;
    }

    .audio-play-btn {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: #1a1a1a;
      border: none;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      transition: background 0.2s;
    }

    .audio-play-btn:hover {
      background: #c9a961;
    }

    .audio-play-btn svg {
      width: 16px;
      height: 16px;
      fill: white;
      margin-left: 2px;
    }

    .audio-info {
      flex: 1;
      min-width: 0;
    }

    .audio-title-label {
      font-family: 'Lato', sans-serif;
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 2px;
      color: #c9a961;
      font-weight: 700;
      display: block;
      margin-bottom: 0.3rem;
    }

    .audio-progress {
      width: 100%;
      height: 2px;
      background: #e0dbd3;
      border-radius: 2px;
      cursor: pointer;
      position: relative;
      margin-top: 0.5rem;
    }

    .audio-progress-fill {
      height: 100%;
      background: #c9a961;
      border-radius: 2px;
      width: 0%;
      transition: width 0.1s linear;
    }

    .audio-time {
      font-family: 'Lato', sans-serif;
      font-size: 0.7rem;
      color: #aaa;
      margin-top: 0.4rem;
      display: block;
    }

    .main-content ul, .main-content ol {
      font-size: 1.05rem;
      line-height: 2;
      color: #3a3a3a;
      padding-left: 1.5rem;
      margin-bottom: 2rem;
      max-width: 680px;
    }

    .main-content li {
      margin-bottom: 0.6rem;
    }

    /* Zurück */
    .back-nav {
      margin-top: 7rem;
      text-align: center;
      padding-top: 3rem;
      border-top: 1px solid #f0ede8;
    }
    .btn-archive {
      text-decoration: none;
      color: #aaa;
      font-family: 'Lato', sans-serif;
      font-weight: 600;
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 2px;
      transition: color 0.2s;
    }
    .btn-archive:hover { color: #1a1a1a; }

    @media (max-width: 850px) {
      .hero-split { grid-template-columns: 1fr; text-align: center; gap: 3rem; }
      .cover-sticky { position: relative; top: 0; max-width: 220px; margin: 0 auto; }
      .main-content p { max-width: 100%; }
      .main-content ul, .main-content ol { max-width: 100%; }
    }
  </style>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      document.querySelectorAll('audio').forEach((audio) => {
        const wrapper = document.createElement('div');
        wrapper.className = 'audio-wrapper';

        const titleLabel = audio.previousElementSibling?.classList?.contains('audio-title-label')
          ? audio.previousElementSibling.textContent
          : 'Musik zum Roman';

        wrapper.innerHTML = `
          <button class="audio-play-btn" aria-label="Abspielen">
            <svg viewBox="0 0 24 24"><polygon points="5,3 19,12 5,21"/></svg>
          </button>
          <div class="audio-info">
            <span class="audio-title-label">${titleLabel}</span>
            <div class="audio-progress"><div class="audio-progress-fill"></div></div>
            <span class="audio-time">0:00</span>
          </div>
        `;

        audio.parentNode.insertBefore(wrapper, audio);
        audio.parentNode.insertBefore(audio, wrapper.nextSibling);

        const btn = wrapper.querySelector('.audio-play-btn');
        const fill = wrapper.querySelector('.audio-progress-fill');
        const timeEl = wrapper.querySelector('.audio-time');
        const progress = wrapper.querySelector('.audio-progress');

        const fmt = (s) => `${Math.floor(s/60)}:${String(Math.floor(s%60)).padStart(2,'0')}`;

        btn.addEventListener('click', () => {
          if (audio.paused) {
            audio.play();
            btn.innerHTML = `<svg viewBox="0 0 24 24" fill="white" width="16" height="16"><rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/></svg>`;
          } else {
            audio.pause();
            btn.innerHTML = `<svg viewBox="0 0 24 24" fill="white" width="16" height="16"><polygon points="5,3 19,12 5,21"/></svg>`;
          }
        });

        audio.addEventListener('timeupdate', () => {
          if (audio.duration) {
            fill.style.width = (audio.currentTime / audio.duration * 100) + '%';
            timeEl.textContent = fmt(audio.currentTime) + ' / ' + fmt(audio.duration);
          }
        });

        audio.addEventListener('ended', () => {
          btn.innerHTML = `<svg viewBox="0 0 24 24" fill="white" width="16" height="16"><polygon points="5,3 19,12 5,21"/></svg>`;
          fill.style.width = '0%';
        });

        progress.addEventListener('click', (e) => {
          const rect = progress.getBoundingClientRect();
          audio.currentTime = ((e.clientX - rect.left) / rect.width) * audio.duration;
        });
      });
    });
  </script>

  <article class="book-page">
    <div class="hero-split">
      <div class="cover-sticky">
        {roman.data.cover && <img src={roman.data.cover} alt={`Cover ${roman.data.title}`} class="book-cover" />}
      </div>
      <div>
        <span class="meta">{roman.data.genre ?? 'Roman'}</span>
        <h1>{roman.data.title}</h1>
        {roman.data.description && <span class="tagline">{roman.data.description}</span>}
      </div>
    </div>
    <div class="main-content">
      <Content />
    </div>
    <footer class="back-nav">
      <a href="/romane/" class="btn-archive">← Zurück zur Roman-Übersicht</a>
    </footer>
  </article>
</BaseLayout>
