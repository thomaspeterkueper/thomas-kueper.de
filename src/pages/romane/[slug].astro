---
// Dateipfad: src/pages/romane/[slug].astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('romane');
  return entries.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const themeMap: Record<string, 'default' | 'dark' | 'stoersignal'> = {
  default: 'default',
  dark: 'dark',
  atmospheric: 'stoersignal',
};
const theme = themeMap[entry.data.customLayout] || 'default';

const universeLabels: Record<string, string> = {
  baumeister: 'Baumeister Universe',
  noxia: 'noχ¹ა Universe',
  standalone: 'Standalone',
};

const placeholderColors: Record<string, { bg: string; accent: string }> = {
  baumeister: { bg: '#1A2A1A', accent: '#C9A961' },
  noxia: { bg: '#1A1A2A', accent: '#4A9B9B' },
  standalone: { bg: '#2A1A1A', accent: '#C41E3A' },
};
const colors = placeholderColors[entry.data.universe] || placeholderColors.standalone;
---

<BaseLayout 
  title={entry.data.title} 
  description={entry.data.description}
  theme={theme}
>

  <article class="section">
    <div class="container">
      
      <header class="book-header">
        <a href="/romane" class="back-link">← Romane</a>
        
        <div class="book-header-inner">
          <!-- Cover -->
          <div class="book-detail-cover">
            {entry.data.coverImage ? (
              <img src={entry.data.coverImage} alt={`Cover: ${entry.data.title}`} />
            ) : (
              <div class="book-detail-placeholder" style={`background: linear-gradient(135deg, ${colors.bg}, ${colors.bg}dd); border-color: ${colors.accent}33;`}>
                <span class="placeholder-accent" style={`color: ${colors.accent};`}>✦</span>
                <span class="placeholder-title">{entry.data.title}</span>
                {entry.data.subtitle && (
                  <span class="placeholder-subtitle">{entry.data.subtitle}</span>
                )}
              </div>
            )}
          </div>

          <!-- Meta -->
          <div class="book-meta">
            <p class="section-label">{universeLabels[entry.data.universe]}</p>
            <h1>{entry.data.title}</h1>
            {entry.data.subtitle && (
              <p class="book-subtitle">{entry.data.subtitle}</p>
            )}
            <span class="hero-ornament" style="margin: var(--space-lg) 0;"></span>
            <div class="book-details">
              <span>{entry.data.genre}</span>
              {entry.data.pageCount && <span>{entry.data.pageCount} Seiten</span>}
              {entry.data.isbn && <span>ISBN {entry.data.isbn}</span>}
            </div>
            <p class="book-description">{entry.data.description}</p>
          </div>
        </div>
      </header>

      <!-- Content -->
      <div class="content-width prose" style="margin-top: var(--space-3xl);">
        <Content />
      </div>

    </div>
  </article>

</BaseLayout>

<style>
  .back-link {
    font-size: var(--size-sm);
    color: var(--text-muted);
    display: inline-block;
    margin-bottom: var(--space-xl);
  }

  .book-header-inner {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: var(--space-3xl);
    align-items: start;
  }

  @media (max-width: 768px) {
    .book-header-inner {
      grid-template-columns: 1fr;
      gap: var(--space-xl);
    }

    .book-detail-cover {
      max-width: 240px;
      margin: 0 auto;
    }
  }

  .book-detail-cover {
    aspect-ratio: 2 / 3;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
  }

  .book-detail-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .book-detail-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 1.5rem;
    text-align: center;
    border: 1px solid;
    border-radius: var(--radius-lg);
    position: relative;
    overflow: hidden;
  }

  .book-detail-placeholder::before {
    content: '';
    position: absolute;
    inset: 0;
    background: 
      radial-gradient(ellipse at 30% 20%, rgba(255,255,255,0.03) 0%, transparent 60%),
      radial-gradient(ellipse at 70% 80%, rgba(255,255,255,0.02) 0%, transparent 50%);
  }

  .placeholder-accent {
    font-size: 1.5rem;
    opacity: 0.6;
  }

  .placeholder-title {
    font-family: var(--font-heading);
    font-size: var(--size-xl);
    font-weight: 700;
    color: #E8E8E8;
    line-height: 1.2;
    position: relative;
  }

  .placeholder-subtitle {
    font-family: var(--font-heading);
    font-size: var(--size-xs);
    font-style: italic;
    color: #999;
    line-height: 1.4;
    max-width: 90%;
    position: relative;
  }

  .book-subtitle {
    font-size: var(--size-xl);
    color: var(--text-muted);
    font-family: var(--font-heading);
    font-style: italic;
    margin-top: var(--space-sm);
  }

  .book-details {
    display: flex;
    gap: var(--space-lg);
    font-size: var(--size-sm);
    color: var(--text-muted);
    flex-wrap: wrap;
  }

  .book-description {
    margin-top: var(--space-lg);
    font-size: var(--size-lg);
    line-height: 1.7;
    color: var(--text);
  }
</style>
