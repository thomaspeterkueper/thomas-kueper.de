---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Bücher" description="Romane, Erzählungen, Science-Fiction, Gegenwartsliteratur, historische Romane und Kinderbücher von Thomas Peter Küper.">
  <style>
    .page{padding:7rem 0}.intro{max-width:760px;margin:0 auto 5rem;text-align:center}.intro h1{font-size:4rem;margin-bottom:1rem}.intro p{color:var(--text-muted);font-size:1.1rem}.section{margin-bottom:5rem}.section h2{font-size:2.6rem;margin-bottom:2rem;border-bottom:1px solid var(--border);padding-bottom:1rem}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:2rem}.book{border:1px solid var(--border);background:#fff;padding:2rem}.book h3{font-size:1.8rem;margin-bottom:.75rem}.book p{color:#555}@media(max-width:900px){.grid{grid-template-columns:1fr}.intro h1{font-size:3rem}}
  </style>

  <section class="page">
    <div class="container">
      <div class="intro">
        <h1>Bücher</h1>
        <p>Eigenständige Romane, Reihen, Kinderbücher und literarische Projekte. Einige Geschichten stehen für sich allein, andere gehören zu größeren Welten.</p>
      </div>

      <section class="section">
        <h2>Science-Fiction</h2>
        <div class="grid">
          <article class="book"><h3>Die Horcher</h3><p>Eine Expedition stößt auf etwas, das möglicherweise zuhört.</p></article>
          <article class="book"><h3>Soma Retep</h3><p>Forschung, Fremdheit und die Grenzen menschlicher Deutung.</p></article>
          <article class="book"><h3>H₂O – Durst</h3><p>Ein eigenständiger Zukunftsroman über Knappheit, Systeme und Entscheidungen.</p></article>
        </div>
      </section>

      <section class="section">
        <h2>Gegenwartsromane</h2>
        <div class="grid">
          <article class="book"><h3>Nichts gefragt</h3><p>Erinnerung, Identität und die Folgen einer Entscheidung.</p></article>
          <article class="book"><h3>MiniNodes</h3><p>Ein eigenständiger Roman über Verbindung, Technik und menschliche Nähe.</p></article>
          <article class="book"><h3>Zereya</h3><p>Eine Geschichte der Gegenwart über Wahrnehmung, Resonanz und Veränderung.</p></article>
        </div>
      </section>

      <section class="section">
        <h2>Historische Romane</h2>
        <div class="grid">
          <article class="book"><h3>Bayt al-Mîrâ</h3><p>Vermessung, Wissen und Geduld im Mittelmeerraum des 12. Jahrhunderts.</p></article>
          <article class="book"><h3>Heimat aus Staub</h3><p>Familiengeschichte zwischen Egerland, Verlust, Vertreibung und Neubeginn.</p></article>
          <article class="book"><h3>Yin Hua</h3><p>Archiv, Erinnerung und verborgene Zusammenhänge.</p></article>
        </div>
      </section>

      <section class="section">
        <h2>Kinderbücher</h2>
        <div class="grid">
          <article class="book"><h3>Feli und das Lichthaus</h3><p>Ein Kinderbuch über Neugier, Freundschaft und kleine Wunder.</p></article>
          <article class="book"><h3>Feli und das halbe Fahrrad</h3><p>Ein weiteres Abenteuer mit Feli, Dingen die fehlen, und Dingen die man findet.</p></article>
          <article class="book"><h3>Feli und das Meer, das fehlt</h3><p>Ein Jura-Abenteuer über Fossilien, Landschaft und Entdeckung.</p></article>
        </div>
      </section>
    </div>
  </section>
</BaseLayout>