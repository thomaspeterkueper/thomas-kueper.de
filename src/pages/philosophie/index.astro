---
// Dateipfad: src/pages/philosophie/index.astro
// Beschreibung: Gateway zur Omnizedenz-Philosophie — 5 Kategorien, kompaktes Layout.
// Aktualisiert am: 14.03.2026

import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Philosophie" 
  description="Omnizedenz, AVI-Modell und Fluide Hermeneutik: Bewusstsein als materielle Resonanz verstehen. Die philosophischen Grundlagen der Werke von Thomas Peter Küper.">

  <style is:inline>
    /* ===== HERO ===== */
    .philo-hero {
      padding: 10rem 2rem 8rem;
      text-align: center;
      background: linear-gradient(180deg, #faf9f6 0%, #ffffff 100%);
      border-bottom: 1px solid #eee;
    }

    .philo-hero .label {
      font-family: 'Lato', sans-serif;
      font-size: 0.65rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 5px;
      color: #c9a961;
      display: block;
      margin-bottom: 2rem;
    }

    .philo-hero h1 {
      font-family: 'Crimson Text', serif;
      font-size: clamp(3rem, 8vw, 5.5rem);
      font-weight: 300;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      margin-bottom: 2rem;
      line-height: 1.1;
    }

    .philo-hero .epigraph {
      font-family: 'Lora', serif;
      font-style: italic;
      font-size: 1.35rem;
      color: #c9a961;
      max-width: 600px;
      margin: 0 auto;
      line-height: 1.6;
    }

    /* ===== INTRO ===== */
    .philo-intro {
      max-width: 800px;
      margin: 0 auto;
      padding: 5rem 2rem 4rem;
    }

    .intro-quote {
      font-family: 'Lora', serif;
      font-size: 1.2rem;
      font-style: italic;
      line-height: 1.9;
      color: #444;
      text-align: center;
      margin-bottom: 2.5rem;
    }

    .intro-body {
      font-family: 'Lora', serif;
      font-size: 1.05rem;
      line-height: 1.9;
      color: #555;
      text-align: center;
      border-top: 1px solid #eee;
      border-bottom: 1px solid #eee;
      padding: 2.5rem 2rem;
    }

    .intro-body strong { color: #1a1a1a; }

    /* ===== DIE DREI SÄULEN ===== */
    .pillars-section {
      background: #faf9f6;
      border-top: 1px solid #eee;
      border-bottom: 1px solid #eee;
      padding: 6rem 2rem;
    }

    .pillars-header {
      text-align: center;
      margin-bottom: 4rem;
    }

    .pillars-header h2 {
      font-family: 'Crimson Text', serif;
      font-size: 2.5rem;
      font-weight: 300;
      margin-bottom: 0.8rem;
    }

    .pillars-header p {
      font-family: 'Lora', serif;
      color: #64748b;
      font-style: italic;
    }

    .pillars-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 2.5rem;
      max-width: 1100px;
      margin: 0 auto;
    }

    .pillar-card {
      background: #ffffff;
      border: 1px solid #eee;
      padding: 3rem 2.5rem;
      transition: all 0.5s cubic-bezier(0.165, 0.84, 0.44, 1);
      position: relative;
    }

    .pillar-card::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 3px;
      background: var(--pillar-accent, #c9a961);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.5s ease;
    }

    .pillar-card:hover {
      transform: translateY(-6px);
      box-shadow: 0 25px 50px rgba(0,0,0,0.05);
      border-color: transparent;
    }

    .pillar-card:hover::before { transform: scaleX(1); }

    .pillar-symbol {
      font-size: 2rem;
      display: block;
      margin-bottom: 1.5rem;
      line-height: 1;
    }

    .pillar-card h3 {
      font-family: 'Crimson Text', serif;
      font-size: 1.7rem;
      margin-bottom: 0.4rem;
    }

    .pillar-card .pillar-subtitle {
      font-family: 'Lato', sans-serif;
      font-size: 0.65rem;
      text-transform: uppercase;
      letter-spacing: 2px;
      color: #c9a961;
      font-weight: 700;
      display: block;
      margin-bottom: 1.5rem;
    }

    .pillar-card p {
      font-family: 'Lora', serif;
      font-size: 0.95rem;
      line-height: 1.7;
      color: #555;
    }

    /* ===== ZENTRALE THESE ===== */
    .thesis-section {
      padding: 7rem 2rem;
      background: #121416;
      color: #ffffff;
    }

    .thesis-inner {
      max-width: 850px;
      margin: 0 auto;
      text-align: center;
    }

    .thesis-inner .label {
      font-family: 'Lato', sans-serif;
      font-size: 0.65rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 5px;
      color: #c9a961;
      display: block;
      margin-bottom: 2.5rem;
    }

    .thesis-inner blockquote {
      font-family: 'Crimson Text', serif;
      font-size: clamp(1.6rem, 3.5vw, 2.5rem);
      font-weight: 300;
      line-height: 1.4;
      margin: 0 0 2.5rem;
      color: #e5dcc8;
    }

    .thesis-inner p {
      font-family: 'Lora', serif;
      font-size: 1.05rem;
      line-height: 1.9;
      color: #94a3b8;
      max-width: 700px;
      margin: 0 auto;
    }

    /* ===== KATEGORIE-GRID (2-spaltig) ===== */
    .categories-wrapper {
      max-width: 1200px;
      margin: 0 auto;
      padding: 6rem 2rem;
    }

    .categories-intro {
      text-align: center;
      margin-bottom: 5rem;
    }

    .categories-intro h2 {
      font-family: 'Crimson Text', serif;
      font-size: 2.5rem;
      font-weight: 300;
      margin-bottom: 0.8rem;
    }

    .categories-intro p {
      font-family: 'Lora', serif;
      color: #64748b;
      font-style: italic;
      font-size: 1.05rem;
    }

    .categories-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 4rem 3.5rem;
    }

    /* Volle Breite für die breiteste Kategorie */
    .cat-block.full-width {
      grid-column: 1 / -1;
    }

    .cat-block .cat-header {
      margin-bottom: 2rem;
      padding-bottom: 1.2rem;
      border-bottom: 1px solid #eee;
    }

    .cat-block .cat-header h3 {
      font-family: 'Crimson Text', serif;
      font-size: 1.8rem;
      font-weight: 400;
      margin-bottom: 0.3rem;
    }

    .cat-block .cat-header p {
      font-family: 'Lora', serif;
      font-size: 0.9rem;
      font-style: italic;
      color: #64748b;
    }

    /* Kompakte Essay-Karten */
    .cat-essays {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    /* Wenn full-width: horizontal statt vertikal */
    .cat-block.full-width .cat-essays {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 1.5rem;
    }

    .cat-block.full-width .essay-link {
      flex: 1 1 280px;
    }

    .essay-link {
      display: flex;
      align-items: baseline;
      gap: 1rem;
      padding: 1.2rem 1.5rem;
      text-decoration: none;
      color: inherit;
      border: 1px solid #f0f0f0;
      background: #fff;
      transition: all 0.35s cubic-bezier(0.165, 0.84, 0.44, 1);
    }

    .essay-link:hover {
      border-color: #c9a961;
      transform: translateX(6px);
      box-shadow: 0 8px 24px rgba(0,0,0,0.04);
    }

    .essay-link .link-type {
      font-family: 'Lato', sans-serif;
      font-size: 0.6rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 2px;
      color: #c9a961;
      white-space: nowrap;
      min-width: 70px;
    }

    .essay-link .link-content {
      flex: 1;
    }

    .essay-link .link-title {
      font-family: 'Crimson Text', serif;
      font-size: 1.15rem;
      display: block;
      margin-bottom: 0.25rem;
      line-height: 1.3;
    }

    .essay-link .link-desc {
      font-family: 'Lora', serif;
      font-size: 0.85rem;
      color: #777;
      line-height: 1.6;
      display: block;
    }

    .essay-link .link-arrow {
      font-size: 0.9rem;
      color: #ccc;
      transition: color 0.3s, transform 0.3s;
      flex-shrink: 0;
    }

    .essay-link:hover .link-arrow {
      color: #c9a961;
      transform: translateX(4px);
    }

    /* ===== CTA / OMNIZEDENZ.DE ===== */
    .extern-cta {
      text-align: center;
      padding: 6rem 2rem;
      border-top: 1px solid #eee;
      max-width: 700px;
      margin: 0 auto;
    }

    .extern-cta h3 {
      font-family: 'Crimson Text', serif;
      font-size: 1.8rem;
      font-weight: 300;
      margin-bottom: 0.8rem;
    }

    .extern-cta p {
      font-family: 'Lora', serif;
      color: #64748b;
      font-size: 1rem;
      line-height: 1.8;
      margin-bottom: 2rem;
    }

    .cta-link {
      display: inline-block;
      background: #1a1a1a;
      color: #fff;
      padding: 1.1rem 2.5rem;
      text-decoration: none;
      font-family: 'Lato', sans-serif;
      font-weight: 700;
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 2px;
      transition: all 0.3s ease;
    }

    .cta-link:hover {
      background: #c9a961;
      transform: translateY(-3px);
    }

    .cta-link-subtle {
      display: inline-block;
      margin-top: 1.2rem;
      text-decoration: none;
      color: #c9a961;
      font-family: 'Lato', sans-serif;
      font-size: 0.8rem;
      font-weight: 700;
      letter-spacing: 1px;
      transition: opacity 0.3s;
    }

    .cta-link-subtle:hover { opacity: 0.7; }

    /* ===== RESPONSIVE ===== */
    @media (max-width: 900px) {
      .pillars-grid { grid-template-columns: 1fr; max-width: 500px; }
      .pillar-card { padding: 2.5rem 2rem; }
      .categories-grid { grid-template-columns: 1fr; gap: 3rem; }
      .cat-block.full-width .cat-essays { flex-direction: column; }
      .thesis-section { padding: 5rem 2rem; }
      .categories-wrapper { padding: 4rem 1.5rem; }
    }
  </style>

  <!-- Hero -->
  <section class="philo-hero">
    <span class="label">Das gedankliche Fundament</span>
    <h1>Philosophie</h1>
    <p class="epigraph">„Omnizedenz & das AVI-Modell"</p>
  </section>

  <!-- Einführung -->
  <section class="philo-intro">
    <p class="intro-quote">
      „Wir alle leben in individuellen Realitätsblasen. Meine Geschichten sind Expeditionen zur vollständigen Realität – jenseits aller Wahrnehmungsfilter."
    </p>
    <div class="intro-body">
      <p>
        Im Zentrum stehen <strong>Omnizedenz</strong>, das <strong>AVI-Modell</strong> 
        und die <strong>Resonanz-Ethik</strong>. Diese Konzepte bilden das Gerüst 
        für meine literarischen Welten — und für eine Philosophie, 
        die Mythen, Märchen und Gegenwart gleichermaßen ernst nimmt.
      </p>
    </div>
  </section>

  <!-- Die drei Säulen -->
  <section class="pillars-section">
    <div class="pillars-header">
      <h2>Die drei Säulen</h2>
      <p>Drei Perspektiven auf dieselbe Frage: Was hält alles zusammen?</p>
    </div>

    <div class="pillars-grid">
      <div class="pillar-card" style="--pillar-accent: #c9a961;">
        <span class="pillar-symbol">∅</span>
        <h3>Omnizedenz</h3>
        <span class="pillar-subtitle">Das Resonanzprinzip</span>
        <p>
          Das Göttliche ist kein Gegenüber — es ist das Feld. 
          Gott als die Summe aller Frequenzen, 
          aus deren Interferenz Komplexität, Bewusstsein und Materie entstehen.
        </p>
      </div>

      <div class="pillar-card" style="--pillar-accent: #2C4E7A;">
        <span class="pillar-symbol">⇌</span>
        <h3>AVI-Modell</h3>
        <span class="pillar-subtitle">Axiomatisches Vakuum-Integral</span>
        <p>
          Die mathematische Formalisierung der Omnizedenz: 
          wie aus dem Vakuumzustand — der kreativen Leere — durch Resonanz 
          die Strukturen der Wirklichkeit emergieren.
        </p>
      </div>

      <div class="pillar-card" style="--pillar-accent: #4a9b9b;">
        <span class="pillar-symbol">⟳</span>
        <h3>Resonanz-Ethik</h3>
        <span class="pillar-subtitle">Handeln als Frequenz</span>
        <p>
          Wenn alles Resonanz ist, hat jede Handlung eine Frequenz. 
          Ethik wird zur Frage der Kopplung: Verstärke ich das System — 
          oder erzeuge ich Dissonanz?
        </p>
      </div>
    </div>
  </section>

  <!-- Zentrale These -->
  <section class="thesis-section">
    <div class="thesis-inner">
      <span class="label">Die zentrale These</span>
      <blockquote>
        Bewusstsein ist kein Produkt der Materie. Materie ist ein Produkt der Resonanz.
      </blockquote>
      <p>
        Die Omnizedenz-Philosophie kehrt die gewohnte Hierarchie um: 
        Nicht das Gehirn erzeugt Bewusstsein, sondern Bewusstsein ist das fundamentale 
        Medium, in dem sich materielle Strukturen als stehende Wellen manifestieren.
      </p>
    </div>
  </section>

  <!-- ===== ALLE KATEGORIEN ===== -->
  <section class="categories-wrapper">
    <div class="categories-intro">
      <h2>Texte & Projekte</h2>
      <p>Fundamente, Methoden, Mythen, Gegenwart und Lyrik — fünf Zugänge zum selben Feld.</p>
    </div>

    <div class="categories-grid">

      <!-- Fundamente -->
      <div class="cat-block">
        <div class="cat-header">
          <h3>Fundamente</h3>
          <p>Ursprungstexte und Grundlagenfragen</p>
        </div>
        <div class="cat-essays">
          <a href="/philosophie/spirale-zwei-urspruenge" class="essay-link">
            <span class="link-type">Projekt</span>
            <span class="link-content">
              <span class="link-title">Die Spirale der Zwei Ursprünge</span>
              <span class="link-desc">Genesis und das Echo der Phaistos-Scheibe</span>
            </span>
            <span class="link-arrow">→</span>
          </a>
          <a href="/philosophie/evolution-des-schoepfers" class="essay-link">
            <span class="link-type">Essay</span>
            <span class="link-content">
              <span class="link-title">Die Evolution des Schöpfers</span>
              <span class="link-desc">Kann das Geschaffene mehr sein als sein Schöpfer?</span>
            </span>
            <span class="link-arrow">→</span>
          </a>
          <a href="/philosophie/physik-der-einsamkeit" class="essay-link">
            <span class="link-type">Sachbuch</span>
            <span class="link-content">
              <span class="link-title">Die Physik der Einsamkeit</span>
              <span class="link-desc">Zwölf Archetypen der Existenz</span>
            </span>
            <span class="link-arrow">→</span>
          </a>
          <a href="/philosophie/was-bleibt-wenn-alles-zerfaellt" class="essay-link">
            <span class="link-type">Essay</span>
            <span class="link-content">
              <span class="link-title">Was bleibt, wenn alles zerfällt</span>
              <span class="link-desc">Omnizedenz und die Physik des Nichts-Trennbaren</span>
            </span>
            <span class="link-arrow">→</span>
          </a>
        </div>
      </div>

      <!-- Systematik & Methode -->
      <div class="cat-block">
        <div class="cat-header">
          <h3>Systematik & Methode</h3>
          <p>Mathematik, Symbolik, Hermeneutik, Ethik</p>
        </div>
        <div class="cat-essays">
          <a href="/philosophie/fluide-hermeneutik" class="essay-link">
            <span class="link-type">Methode</span>
            <span class="link-content">
              <span class="link-title">Fluide Hermeneutik</span>
              <span class="link-desc">Verstehen als lebendiger Prozess</span>
            </span>
            <span class="link-arrow">→</span>
          </a>
          <a href="/philosophie/avi-vertiefung" class="essay-link">
            <span class="link-type">Mathematik</span>
            <span class="link-content">
              <span class="link-title">AVI-Vertiefung</span>
              <span class="link-desc">Operatoren, Physik und Bewusstseinstheorie</span>
            </span>
            <span class="link-arrow">→</span>
          </a>
          <a href="/philosophie/zeichen-fuer-das-unsagbare" class="essay-link">
            <span class="link-type">Symbole</span>
            <span class="link-content">
              <span class="link-title">Zeichen für das Unsagbare</span>
              <span class="link-desc">Die 28 Symbole der Omnizedenz</span>
            </span>
            <span class="link-arrow">→</span>
          </a>
          <a href="/philosophie/resonanz-ethik" class="essay-link">
            <span class="link-type">Ethik</span>
            <span class="link-content">
              <span class="link-title">Grundlagen der Resonanzethik</span>
              <span class="link-desc">Handeln jenseits von Pflicht und Nutzen</span>
            </span>
            <span class="link-arrow">→</span>
          </a>
        </div>
      </div>

      <!-- Mythos & Erzählung -->
      <div class="cat-block">
        <div class="cat-header">
          <h3>Mythos & Erzählung</h3>
          <p>Märchen, Sagen, klassische Werke — neu gelesen</p>
        </div>
        <div class="cat-essays">
          <a href="/philosophie/faust-omnizedenz" class="essay-link">
            <span class="link-type">Analyse</span>
            <span class="link-content">
              <span class="link-title">Faust im Licht der Omnizedenz</span>
              <span class="link-desc">Streben, Schatten und Transformation</span>
            </span>
            <span class="link-arrow">→</span>
          </a>
          <a href="/philosophie/goettliches-spiel-des-bewusstseins" class="essay-link">
            <span class="link-type">Essay</span>
            <span class="link-content">
              <span class="link-title">Das göttliche Spiel des Bewusstseins</span>
              <span class="link-desc">Die Offenbarung als zeitloser Spiegel der Bewusstseinsentwicklung</span>
            </span>
            <span class="link-arrow">→</span>
          </a>
        </div>
      </div>

      <!-- Gesellschaft & Gegenwart -->
      <div class="cat-block">
        <div class="cat-header">
          <h3>Gesellschaft & Gegenwart</h3>
          <p>Wenn Omnizedenz-Denken auf Wirklichkeit trifft</p>
        </div>
        <div class="cat-essays">
          <a href="/philosophie/paradoxie-der-ordnung" class="essay-link">
            <span class="link-type">Essay</span>
            <span class="link-content">
              <span class="link-title">Die Paradoxie der Ordnung</span>
              <span class="link-desc">Warum Musterstaaten an ihrer Perfektion ersticken können</span>
            </span>
            <span class="link-arrow">→</span>
          </a>
          <a href="/philosophie/wirtschaftspsychologie-omnizedenz" class="essay-link">
            <span class="link-type">Essay</span>
            <span class="link-content">
              <span class="link-title">Wenn die Klinke sinkt</span>
              <span class="link-desc">Resonanz in Organisationen und das Ayia-Protokoll</span>
            </span>
            <span class="link-arrow">→</span>
          </a>
          <a href="/philosophie/machiavelli-omnizedenz" class="essay-link">
            <span class="link-type">Essay</span>
            <span class="link-content">
              <span class="link-title">Machiavelli als Grenzfall der Omnizedenz</span>
              <span class="link-desc">Resonanzphänomene, politische Macht und der fehlende Term</span>
            </span>
            <span class="link-arrow">→</span>
          </a>
        </div>
      </div>

      <!-- Lyrik & Manifest — volle Breite als Abschluss -->
      <div class="cat-block full-width">
        <div class="cat-header">
          <h3>Lyrik & Manifest</h3>
          <p>Die verdichtete Form — wo Philosophie zur Sprache wird</p>
        </div>
        <div class="cat-essays">
          <a href="/philosophie/wenn-worte-welten-formen" class="essay-link">
            <span class="link-type">Gedicht</span>
            <span class="link-content">
              <span class="link-title">Wenn Worte Welten formen</span>
              <span class="link-desc">Ein lyrisches Manifest über die schöpferische Kraft der Sprache</span>
            </span>
            <span class="link-arrow">→</span>
          </a>
        </div>
      </div>

    </div>
  </section>

  <!-- CTA: omnizedenz.de -->
  <section class="extern-cta">
    <h3>Vollständige Ausarbeitung</h3>
    <p>
      Die detaillierte philosophische Entfaltung der Omnizedenz 
      finden Sie auf der dedizierten Projektseite.
    </p>
    <a href="https://omnizedenz.de" target="_blank" rel="noopener" class="cta-link">omnizedenz.de besuchen →</a>
    <br />
    <a href="/sachbuecher" class="cta-link-subtle">Sachbücher & Forschung →</a>
  </section>

</BaseLayout>
