---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Philosophie" description="Archivierte Einstiegsseite zu Grundlagen, Texten, Omnizedenz, AVI, Mishkenaz und philosophischen Essays von Thomas Peter Küper.">
  <style is:inline>
    .page-hero{padding:9rem 2rem 5rem;text-align:center;background:linear-gradient(180deg,#faf9f6 0%,#fff 100%);border-bottom:1px solid #eee}.label{font-family:'Lato',sans-serif;font-size:.65rem;font-weight:700;text-transform:uppercase;letter-spacing:5px;color:#c9a961;display:block;margin-bottom:2rem}.page-hero h1{font-family:'Crimson Text',serif;font-size:clamp(3rem,8vw,5rem);font-weight:300;letter-spacing:.12em;text-transform:uppercase;margin-bottom:1.5rem}.intro{font-family:'Lora',serif;font-size:1.15rem;line-height:1.8;color:#555;max-width:720px;margin:0 auto}.bridge{max-width:1050px;margin:0 auto;padding:5rem 2rem 7rem}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:2rem}.card{background:#fff;border:1px solid #eee;padding:3rem 2.5rem;text-decoration:none;color:inherit;transition:.3s}.card:hover{border-color:#c9a961;transform:translateY(-5px);box-shadow:0 18px 40px rgba(0,0,0,.05)}.card span{font-family:'Lato',sans-serif;font-size:.65rem;font-weight:700;text-transform:uppercase;letter-spacing:3px;color:#c9a961;display:block;margin-bottom:1rem}.card h2{font-family:'Crimson Text',serif;font-size:2rem;font-weight:300;margin-bottom:1rem}.card p{font-family:'Lora',serif;font-size:.98rem;line-height:1.75;color:#555}.note{margin-top:4rem;padding-top:3rem;border-top:1px solid #eee;text-align:center;font-family:'Lora',serif;font-size:.95rem;line-height:1.8;color:#777;font-style:italic}@media(max-width:850px){.grid{grid-template-columns:1fr}.page-hero{padding-top:7rem}}
  </style>

  <section class="page-hero">
    <span class="label">Archivierter Bereich</span>
    <h1>Philosophie</h1>
    <p class="intro">Dieser ältere Bereich wird neu einsortiert. Die grundlegenden Konzepte liegen jetzt unter <strong>Grundlagen</strong>, einzelne Essays und Gedankentexte unter <strong>Texte</strong>.</p>
  </section>

  <section class="bridge">
    <div class="grid">
      <a class="card" href="/grundlagen">
        <span>Fundament</span>
        <h2>Grundlagen</h2>
        <p>Omnizedenz, AVI, Mishkenaz und die Modelle hinter den Welten und Texten.</p>
      </a>
      <a class="card" href="/texte">
        <span>Essays</span>
        <h2>Texte</h2>
        <p>Gesellschaft, Forschung, Mythen, Musik, Tiefenwörter, Lyrik und Manifeste.</p>
      </a>
      <a class="card" href="/kontrakomologie">
        <span>Zeitwahrnehmung</span>
        <h2>Kontrakomologie</h2>
        <p>Texte, Musik und die Art, wie Zeit beim Lesen und Hören entsteht.</p>
      </a>
    </div>
    <p class="note">Die alten philosophischen Einzeltexte bleiben vorerst erhalten. Schrittweise werden sie in die bestehende Texte-Struktur übernommen, ohne Inhalte zu verlieren.</p>
  </section>
</BaseLayout>