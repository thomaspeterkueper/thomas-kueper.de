---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Welten" description="Die literarischen Welten Baumeister und noχ¹ᐃ von Thomas Peter Küper.">
  <style is:inline>
    .page {
      padding: 7rem 0;
    }

    .intro {
      max-width: 760px;
      margin: 0 auto 5rem;
      text-align: center;
    }

    .intro h1 {
      font-family: 'Crimson Text', Georgia, serif;
      font-size: clamp(3rem, 7vw, 4.6rem);
      font-weight: 300;
      line-height: 1;
      margin-bottom: 1.25rem;
    }

    .intro p {
      color: var(--text-muted);
      font-family: 'Lora', serif;
      font-size: 1.1rem;
      line-height: 1.8;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 2.5rem;
    }

    .world {
      position: relative;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      min-height: 34rem;
      padding: 3rem;
      text-decoration: none;
      color: #fff;
      overflow: hidden;
      border: 1px solid var(--border);
      isolation: isolate;
      transition: transform .5s ease, box-shadow .5s ease;
    }

    .world::before {
      content: "";
      position: absolute;
      inset: 0;
      background-size: cover;
      background-position: center;
      transform: scale(1.04);
      transition: transform 1.1s ease, filter 1.1s ease;
      z-index: -2;
    }

    .world::after {
      content: "";
      position: absolute;
      inset: 0;
      z-index: -1;
      transition: opacity .8s ease;
    }

    .world .label {
      font-family: 'Lato', sans-serif;
      font-size: .65rem;
      text-transform: uppercase;
      letter-spacing: .22em;
      font-weight: 700;
      margin-bottom: 1rem;
      display: block;
    }

    .world h2 {
      font-family: 'Crimson Text', Georgia, serif;
      font-size: clamp(2.5rem, 5vw, 3.35rem);
      font-weight: 300;
      margin-bottom: 1rem;
      color: #fff;
      line-height: 1.05;
    }

    .world p {
      color: rgba(255,255,255,.84);
      font-family: 'Lora', serif;
      line-height: 1.75;
      max-width: 35ch;
      margin: 0;
    }

    .link {
      display: inline-block;
      margin-top: 2rem;
      font-family: 'Lato', sans-serif;
      font-size: .7rem;
      text-transform: uppercase;
      letter-spacing: .2em;
      color: #fff;
      border-bottom: 1px solid var(--gold);
      padding-bottom: .15rem;
      transition: letter-spacing .4s ease;
      width: fit-content;
    }

    .baumeister::before {
      background-image: url('/assets/universen/baumeister-karte.png');
      filter: saturate(1);
    }

    .baumeister::after {
      background:
        linear-gradient(180deg, rgba(20,28,28,.55) 0%, rgba(20,28,28,.15) 45%, rgba(30,22,14,.72) 100%),
        radial-gradient(120% 90% at 70% 110%, rgba(201,169,97,.28), transparent 60%);
    }

    .baumeister .label {
      color: var(--gold);
    }

    .nox::before {
      background-image: url('/assets/universen/noxia-karte.png');
      filter: saturate(.9) brightness(.85);
    }

    .nox::after {
      background:
        linear-gradient(180deg, rgba(6,10,18,.72) 0%, rgba(6,10,18,.35) 40%, rgba(6,10,18,.9) 100%),
        radial-gradient(120% 90% at 30% 115%, rgba(126,190,190,.22), transparent 62%);
    }

    .nox .label {
      color: var(--petrol-light, #7EBEBE);
    }

    .world:hover {
      transform: translateY(-6px);
      box-shadow: 0 20px 50px -20px rgba(0,0,0,.55);
    }

    .world:hover .link {
      letter-spacing: .28em;
    }

    .world:hover::before {
      transform: scale(1.09);
    }

    .baumeister:hover::before {
      filter: saturate(1.15) brightness(1.05);
    }

    .nox:hover::before {
      filter: saturate(1) brightness(1.05);
    }

    .coda {
      max-width: 640px;
      margin: 5rem auto 0;
      text-align: center;
      font-family: 'Crimson Text', Georgia, serif;
      font-style: italic;
      font-size: 1.25rem;
      color: var(--text-muted);
      line-height: 1.6;
    }

    @media (max-width: 900px) {
      .grid {
        grid-template-columns: 1fr;
      }

      .world {
        min-height: 26rem;
        padding: 2.25rem;
      }
    }
  </style>

  <section class="page">
    <div class="container">
      <div class="intro">
        <h1>Welten</h1>
        <p>Zwei Zeitebenen einer größeren Kontinuität: Baumeister bewahrt Spuren, Sprache und Erinnerung. noχ¹ᐃ öffnet die Zukunft des Sonnensystems.</p>
      </div>

      <div class="grid">
        <a href="/universen/baumeister" class="world baumeister">
          <span class="label">Vergangenheit bis Gegenwart</span>
          <h2>Baumeister</h2>
          <p>Ein Kontinuum aus historischen Spuren, verborgenen Zusammenhängen, Sprache, Erinnerung und wiederkehrenden Mustern.</p>
          <span class="link">Baumeister erkunden</span>
        </a>

        <a href="/universen/nox" class="world nox">
          <span class="label">Zukunft des Sonnensystems</span>
          <h2>noχ¹ᐃ</h2>
          <p>Die Zukunft der Menschheit zwischen Erde, Mars und den äußeren Regionen: Romane, Wissenschaft, Spielentwicklung und Weltbau.</p>
          <span class="link">noχ¹ᐃ entdecken</span>
        </a>
      </div>

      <p class="coda">Zwei Enden desselben Fadens — was verschüttet liegt, und was noch nicht begonnen hat.</p>
    </div>
  </section>
</BaseLayout>
