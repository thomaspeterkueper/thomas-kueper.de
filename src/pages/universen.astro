---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Welten" description="Die literarischen Welten Baumeister und NOXIA von Thomas Peter Küper.">
  <style>
    .page{padding:7rem 0}.intro{max-width:760px;margin:0 auto 5rem;text-align:center}.intro h1{font-size:4rem;margin-bottom:1rem}.intro p{color:var(--text-muted);font-size:1.1rem}.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:2.5rem}.world{border:1px solid var(--border);background:#fff;padding:3rem;text-decoration:none;color:inherit}.world h2{font-size:2.6rem;margin-bottom:1rem}.label{font-family:'Lato',sans-serif;font-size:.65rem;text-transform:uppercase;letter-spacing:.22em;color:var(--gold);font-weight:700;margin-bottom:1rem;display:block}.world p{color:#555}.link{display:inline-block;margin-top:2rem;font-family:'Lato',sans-serif;font-size:.7rem;text-transform:uppercase;letter-spacing:.2em;border-bottom:1px solid var(--gold)}@media(max-width:900px){.grid{grid-template-columns:1fr}.intro h1{font-size:3rem}}
  </style>

  <section class="page">
    <div class="container">
      <div class="intro">
        <h1>Welten</h1>
        <p>Zwei große literarische Räume: Baumeister reicht von Vergangenheit bis Gegenwart. NOXIA beginnt in der Zukunft des Sonnensystems.</p>
      </div>

      <div class="grid">
        <a href="/universen/baumeister" class="world">
          <span class="label">Vergangenheit bis Gegenwart</span>
          <h2>Baumeister</h2>
          <p>Ein Kontinuum aus historischen Romanen, Archivgeschichten, Figuren, Orten und verborgenen Zusammenhängen.</p>
          <span class="link">Baumeister erkunden</span>
        </a>

        <a href="/universen/nox" class="world">
          <span class="label">Zukunft des Sonnensystems</span>
          <h2>NOXIA</h2>
          <p>Die Zukunft der Menschheit zwischen Erde, Mars und äußeren Regionen: Romane, Spielentwicklung, Wissenschaft und Weltbau.</p>
          <span class="link">NOXIA entdecken</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>