---
import BaseLayout from '../layouts/BaseLayout.astro';
import authorImg from '../assets/portrait3.jpg';
---

<BaseLayout title="Thomas Peter Küper" description="Autor, Weltenbauer, Musiker und Entwickler von Ideen.">
<style>
.home-hero{padding:clamp(4.5rem,7vh,6.5rem) 0;background:var(--bg-soft);border-bottom:1px solid var(--border)}
.hero-grid{display:grid;grid-template-columns:minmax(320px,400px) minmax(520px,720px);gap:clamp(4rem,6vw,6rem);align-items:center;justify-content:center}
.portrait-img{width:100%;max-height:560px;object-fit:cover;border:1px solid var(--border);box-shadow:0 24px 56px rgba(0,0,0,.08)}
.eyebrow{font-family:'Lato',sans-serif;font-size:.7rem;font-weight:700;text-transform:uppercase;letter-spacing:.22em;color:var(--gold);margin-bottom:1rem}
h1{font-size:clamp(3rem,4.8vw,5.2rem);font-weight:300;line-height:1.1;margin:0 0 1.5rem}
.hero-text p{max-width:660px;font-size:1.08rem;line-height:1.9;margin-bottom:1.5rem;color:#333}
.links{display:flex;gap:1.5rem;flex-wrap:wrap;margin-top:2rem}.text-link{display:inline-block;font-family:'Lato',sans-serif;font-size:.72rem;font-weight:700;text-transform:uppercase;letter-spacing:.22em;color:var(--text);text-decoration:none;border-bottom:1px solid var(--gold);padding-bottom:.35rem}
.section{padding:5rem 0}.section h2{text-align:center;font-size:3rem;margin-bottom:3rem}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:2rem}.card{background:#fff;border:1px solid var(--border);padding:2rem;text-decoration:none;color:inherit}.card h3{margin-bottom:.75rem}.soft{background:var(--bg-soft);border-top:1px solid var(--border)}
@media(max-width:950px){.hero-grid,.grid{grid-template-columns:1fr}.hero-grid{text-align:center}.portrait-img{max-width:340px;margin:0 auto}.hero-text p{margin-left:auto;margin-right:auto}.links{justify-content:center}}
</style>

<section class="home-hero">
<div class="container hero-grid">
<div><img src={authorImg.src} alt="Thomas Peter Küper" class="portrait-img" /></div>
<div class="hero-text">
<div class="eyebrow">Über mich</div>
<h1>Thomas Peter Küper</h1>
<p>Ich schreibe Romane, Kinderbücher, Science-Fiction und Essays. Meine Arbeit verbindet Geschichten, Sprache, Musik, Wissenschaft, Zeitwahrnehmung und eigene Denkmodelle.</p>
<p>Im Zentrum stehen Menschen, die etwas sehen, hören oder begreifen, das nicht in die vorhandenen Systeme passt — und die trotzdem versuchen, dafür eine Form zu finden.</p>
<div class="links"><a href="/ueber-mich" class="text-link">Mehr über mich</a><a href="/romane" class="text-link">Bücher ansehen</a></div>
</div></div></section>

<section class="section">
<div class="container"><h2>Aktuelle Bücher</h2><div class="grid"><a class="card" href="/romane/nichts-gefragt/"><h3>Nichts gefragt</h3><p>Ein literarischer Roman über Vaterschaft, Herkunft und siebzehn Jahre Schweigen.</p></a><a class="card" href="/romane/feli-und-das-lichthaus/"><h3>Feli und das Lichthaus</h3><p>Ein Kinderbuch über Neugier, Rätsel und ein Haus, das nachts leuchtet.</p></a><a class="card" href="/romane/die-horcher/"><h3>Die Horcher</h3><p>Science-Fiction über eine Expedition und etwas, das möglicherweise zuhört.</p></a></div></div>
</section>

<section class="section soft"><div class="container"><h2>Welten und Grundlagen</h2><div class="grid"><a href="/universen" class="card"><h3>Welten</h3><p>Baumeister und NOXIA als literarische Räume.</p></a><a href="/grundlagen" class="card"><h3>Grundlagen</h3><p>Omnizedenz, AVI und Mishkenaz.</p></a><a href="/kontrakomologie" class="card"><h3>Kontrakomologie</h3><p>Texte, Musik und das Erleben von Zeit.</p></a></div></div></section>
</BaseLayout>