---
import BaseLayout from '../layouts/BaseLayout.astro';
import authorImg from '../assets/portrait3.jpg';
import nichtsGefragtCover from '../assets/romane/Nichts_Gefragt/nichts_gefragt Cover.png';
import feliCover from '../assets/romane/Feli_Und/Das_Lichthaus.png';
import horcherCover from '../assets/romane/Soma_Retep/Die_Horcher_Cover.png';
import xerxesCover from '../assets/romane/xerxes/XERXES.png';
---

<BaseLayout title="Thomas Peter Küper" description="Autor von Gegenwartsliteratur, Kinderbüchern und Science-Fiction.">
<style>
.home-hero{padding:4.5rem 0;background:var(--bg-soft);border-bottom:1px solid var(--border)}
.hero-grid{display:grid;grid-template-columns:minmax(320px,390px) minmax(520px,680px);gap:5rem;align-items:center;justify-content:center}
.portrait-img{width:100%;max-height:520px;object-fit:cover;border:1px solid var(--border);box-shadow:0 24px 56px rgba(0,0,0,.08)}
h1{font-size:clamp(3rem,4.5vw,5rem);font-weight:300;line-height:1.1;margin:0 0 1.5rem}
.hero-text p{max-width:620px;font-size:1.05rem;line-height:1.85;margin-bottom:1.5rem}
.text-link{display:inline-block;font-family:'Lato',sans-serif;font-size:.72rem;font-weight:700;text-transform:uppercase;letter-spacing:.22em;color:var(--text);text-decoration:none;border-bottom:1px solid var(--gold);padding-bottom:.35rem}
.section{padding:5rem 0}.section h2{text-align:center;font-size:3rem;margin-bottom:3rem}
.books-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:2rem}.book{background:#fff;text-decoration:none;color:inherit}.book-cover{aspect-ratio:2/3;overflow:hidden;border:1px solid var(--border);box-shadow:0 18px 40px rgba(0,0,0,.08);background:#faf9f6}.book-cover img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .4s ease}.book:hover img{transform:translateY(-6px)}.book-body{padding:1.4rem 0 0}.book h3{margin:.4rem 0 .6rem;font-size:1.55rem}.book p{font-size:.95rem;line-height:1.7;color:#555}.label{font-family:'Lato',sans-serif;font-size:.68rem;letter-spacing:.18em;text-transform:uppercase;color:var(--gold);font-weight:700}
.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:2rem}.card{background:#fff;border:1px solid var(--border);padding:2rem;text-decoration:none;color:inherit}.soft{background:var(--bg-soft);border-top:1px solid var(--border)}
@media(max-width:950px){.hero-grid,.books-grid,.grid{grid-template-columns:1fr}.hero-grid{text-align:center}.portrait-img{max-width:340px;margin:0 auto}.hero-text p{margin:auto}.book{max-width:320px;margin:0 auto}.book-body{text-align:center}}
</style>

<section class="home-hero">
<div class="container hero-grid">
<div><img src={authorImg.src} alt="Thomas Peter Küper" class="portrait-img" /></div>
<div class="hero-text">
<h1>Autor von Gegenwartsliteratur, Kinderbüchern und Science-Fiction</h1>
<p>Geschichten über Erinnerung, Herkunft, Neugier, Wahrnehmung und die Zukunft. Manche spielen in unserer Gegenwart. Andere reichen bis in die äußeren Regionen des Sonnensystems.</p>
<a href="/romane" class="text-link">Zu den Büchern</a>
</div></div></section>

<section class="section">
<div class="container">
<h2>Aktuelle Bücher</h2>
<div class="books-grid">
<a class="book" href="/romane/nichts-gefragt/"><div class="book-cover"><img src={nichtsGefragtCover.src} alt="Cover: Nichts gefragt" /></div><div class="book-body"><div class="label">Roman</div><h3>Nichts gefragt</h3><p>Vaterschaft, Herkunft und siebzehn Jahre Schweigen zwischen Delhi, Chiang Mai und London.</p></div></a>
<a class="book" href="/romane/feli-und-das-lichthaus/"><div class="book-cover"><img src={feliCover.src} alt="Cover: Feli und das Lichthaus" /></div><div class="book-body"><div class="label">Kinderbuch</div><h3>Feli und das Lichthaus</h3><p>Ein altes Haus auf der Klippe leuchtet jede Nacht. Feli möchte herausfinden warum.</p></div></a>
<a class="book" href="/romane/die-horcher/"><div class="book-cover"><img src={horcherCover.src} alt="Cover: Die Horcher" /></div><div class="book-body"><div class="label">Science Fiction</div><h3>Die Horcher</h3><p>Eine Expedition stößt auf etwas, das möglicherweise zuhört.</p></div></a>
<a class="book" href="/romane/xerxes/"><div class="book-cover"><img src={xerxesCover.src} alt="Cover: Xerxes" /></div><div class="book-body"><div class="label">Das Gefälle</div><h3>Xerxes</h3><p>Ein funktionierendes System steuert auf einen Kollaps zu, den niemand verhindern kann.</p></div></a>
</div>
</div>
</section>

<section class="section soft"><div class="container"><h2>Welten</h2><div class="grid"><a href="/universen/baumeister" class="card"><h3>Baumeister</h3><p>Geschichten, Ideen und Zusammenhänge von der Vergangenheit bis zur Gegenwart.</p></a><a href="/universen/nox" class="card"><h3>NOXIA</h3><p>Die Zukunft der Menschheit im Sonnensystem.</p></a></div></div></section>

<section class="section"><div class="container" style="max-width:800px;text-align:center;"><h2>Grundlagen</h2><p>Omnizedenz, AVI, Mishkenaz und weitere Konzepte hinter den Welten und Texten.</p></div></section>

<section class="section soft"><div class="container" style="max-width:800px;text-align:center;"><h2>Kontrakomologie</h2><p>Eine Betrachtungsweise für Texte, Musik und das Erleben von Zeit.</p></div></section>
</BaseLayout>