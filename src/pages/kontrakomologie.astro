---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Kontrakomologie" description="Kontrakomologie als Betrachtungsweise für Texte, Musik, Kunst und das Erleben von Zeit.">
  <style>
    .page{padding:7rem 0}.intro{max-width:820px;margin:0 auto 5rem;text-align:center}.intro h1{font-size:4rem;margin-bottom:1rem}.intro p{color:var(--text-muted);font-size:1.12rem}.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:2rem}.card{border:1px solid var(--border);background:#fff;padding:2.5rem}.card h2{font-size:2rem;margin-bottom:1rem}.card p{color:#555}.quote{margin:5rem auto 0;max-width:760px;text-align:center;font-size:1.3rem;font-style:italic;color:var(--text)}@media(max-width:900px){.grid{grid-template-columns:1fr}.intro h1{font-size:3rem}}
  </style>

  <section class="page">
    <div class="container">
      <div class="intro">
        <h1>Kontrakomologie</h1>
        <p>Kontrakomologie ist eine Betrachtungsweise für Texte, Musik und Kunst. Sie fragt nicht nur, was ein Werk erzählt, sondern wie beim Lesen, Hören oder Betrachten ein eigenes Gefühl von Zeit entsteht.</p>
      </div>

      <div class="grid">
        <article class="card"><h2>Literatur</h2><p>Wie Erzähltempo, Perspektive, Erinnerung und Erwartung die Zeit eines Textes formen.</p></article>
        <article class="card"><h2>Musik</h2><p>Wie Rhythmus, Wiederholung, Pause und Klangräume Dauer erfahrbar machen.</p></article>
        <article class="card"><h2>Kunst</h2><p>Wie Bilder, Räume und Symbole eine eigene innere Zeit erzeugen können.</p></article>
        <article class="card"><h2>Methode</h2><p>Ein Zugang, der Analyse, Wahrnehmung und das subjektive Erleben eines Werkes verbindet.</p></article>
      </div>

      <p class="quote">Nicht nur das Werk vergeht in der Zeit. Das Werk erzeugt Zeit.</p>
    </div>
  </section>
</BaseLayout>