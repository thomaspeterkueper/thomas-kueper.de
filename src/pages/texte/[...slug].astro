---
// Dateipfad: src/pages/texte/[...slug].astro
// Beschreibung: Dynamisches Rendering einzelner Texte aus der Content Collection.
// Jede .md-Datei in src/content/texte/ wird automatisch als Seite verfügbar.

import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const texte = await getCollection('texte', ({ data }) => !data.draft);
  return texte.map(entry => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

// Kategorie-Labels
const katLabels: Record<string, string> = {
  'mythen-maerchen-sagen': 'Mythen, Märchen & Sagen',
  'gesellschaft-gegenwart': 'Gesellschaft & Gegenwart',
  'musik-klang': 'Musik & Klang',
  'natur-wissenschaft': 'Natur & Wissenschaft',
  'geschichte': 'Geschichte',
  'forschung': 'Forschung',
  'lyrik-manifest': 'Lyrik & Manifest',
  'tiefenwoerter': 'Tiefenwörter',
  'denken': 'Theologische Reihe',
  'texte': 'Essay',
};

const katLabel = katLabels[entry.data.kategorie] || entry.data.kategorie;
---

<BaseLayout
  title={`${entry.data.title} — Thomas Peter Küper`}
  description={entry.data.description}>

  <style is:inline>
    /* Seitenhintergrund creme */
    body { background: #f0ede8 !important; }

    /* ===== ESSAY HERO ===== */
    .essay-hero {
      padding: 7rem 2rem 2.5rem;
      text-align: center;
      background: linear-gradient(180deg, #faf9f6 0%, #f0ede8 100%);
      border-bottom: none;
    }

    .essay-hero .label {
      font-family: 'Lato', sans-serif;
      font-size: 0.6rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 4px;
      color: #c9a961;
      display: block;
      margin-bottom: 1.25rem;
    }

    .essay-hero h1 {
      font-family: 'Crimson Text', serif;
      font-size: clamp(2rem, 4.5vw, 3rem);
      font-weight: 300;
      line-height: 1.2;
      margin-bottom: 0.85rem;
      max-width: 680px;
      margin-left: auto;
      margin-right: auto;
      color: #111;
    }

    .essay-hero .subtitle {
      font-family: 'Lora', serif;
      font-style: italic;
      font-size: 1.05rem;
      color: #666;
      max-width: 560px;
      margin: 0 auto 1.5rem;
      line-height: 1.55;
    }

    .essay-hero .meta-line {
      font-family: 'Lato', sans-serif;
      font-size: 0.65rem;
      text-transform: uppercase;
      letter-spacing: 2px;
      color: #aaa;
    }

    .essay-hero .meta-line .typ-badge {
      display: inline-block;
      background: rgba(0,0,0,0.05);
      padding: 0.25rem 0.7rem;
      margin-right: 0.8rem;
      color: #777;
    }

    /* ===== WEISSES PAPIER ===== */
    .essay-content {
      background: #ffffff;
      box-shadow: 0 2px 28px rgba(0,0,0,0.08), 0 0 0 1px rgba(0,0,0,0.04);
      max-width: 660px;
      margin: 0 auto;
      padding: 3rem 3.5rem 3.5rem;
    }

    /* ===== TEXT ===== */
    .essay-content p {
      font-family: 'Lora', serif;
      font-size: 1.05rem;
      line-height: 1.82;
      color: #1a1a1a;
      margin-bottom: 0.9rem;
    }

    /* Theologische Essays: Autorzeile ausblenden */
    .essay-content.theological > p:first-child:has(> em:only-child),
    .essay-content.theological > p:first-child:has(> em:only-child) + hr {
      display: none;
    }

    /* Initialbuchstabe */
    .essay-content:not(.theological) > p:first-of-type::first-letter,
    .essay-content.theological > p:first-child:has(> em:only-child) + hr + p::first-letter {
      font-family: 'Crimson Text', serif;
      font-size: 3.5rem;
      float: left;
      line-height: 0.82;
      margin-right: 0.12em;
      margin-top: 0.08em;
      color: #c9a961;
    }

    /* Abschnittstitel */
    .essay-content h2 {
      font-family: 'Lato', sans-serif;
      font-size: 0.72rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.16em;
      margin-top: 2.25rem;
      margin-bottom: 0.8rem;
      color: #888;
      text-align: left;
    }

    .essay-content h3 {
      font-family: 'Crimson Text', serif;
      font-size: 1.2rem;
      font-weight: 400;
      margin-top: 1.5rem;
      margin-bottom: 0.55rem;
      color: #111;
    }

    /* Trennlinien */
    .essay-content hr {
      border: none;
      text-align: center;
      margin: 1.75rem 0;
      color: #bbb;
    }

    .essay-content hr::after {
      content: '· · ·';
      letter-spacing: 0.8em;
      font-size: 0.85rem;
    }

    /* Blockzitat */
    .essay-content blockquote {
      font-family: 'Crimson Text', serif;
      font-size: 1.3rem;
      font-weight: 300;
      line-height: 1.5;
      color: #1a1a1a;
      text-align: center;
      padding: 1.25rem 1.5rem;
      margin: 1.5rem 0;
      border-top: 1px solid #ddd;
      border-bottom: 1px solid #ddd;
    }

    .essay-content blockquote p {
      font-family: inherit;
      font-size: inherit;
      line-height: inherit;
      color: inherit;
      margin: 0;
    }

    .essay-content strong { color: #111; font-weight: 600; }
    .essay-content em { color: #444; }

    .essay-content ul, .essay-content ol {
      font-family: 'Lora', serif;
      font-size: 1rem;
      line-height: 1.8;
      color: #222;
      margin-bottom: 0.9rem;
      padding-left: 1.5rem;
    }

    .essay-content li { margin-bottom: 0.3rem; }

    /* Links im Text */
    .essay-content a {
      color: #1e3a5f;
      text-decoration: none;
      border-bottom: 1px solid rgba(30,58,95,0.25);
      transition: border-color 0.2s;
    }

    .essay-content a:hover { border-color: #1e3a5f; }

    /* ===== REIHEN-NAVIGATION (unten, auf cremefarbenem Grund) ===== */
    .essay-content > p:last-child {
      margin: 2.5rem -3.5rem -3.5rem;
      padding: 1.25rem 3.5rem;
      background: #ebe7e0;
      border-top: 1px solid #ddd8d0;
    }

    .essay-content > p:last-child em {
      display: block;
      font-style: normal;
      font-family: 'Lato', sans-serif;
      font-size: 0.7rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.13em;
      color: #777;
      text-align: center;
    }

    .essay-content > p:last-child em a {
      color: #1e3a5f;
      border-bottom: 1px solid rgba(30,58,95,0.3);
      font-style: normal;
      letter-spacing: inherit;
    }

    .essay-content > p:last-child em a:hover {
      border-color: #1e3a5f;
    }

    /* ===== TAGS ===== */
    .essay-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      justify-content: center;
      padding: 2rem 2rem 1.5rem;
      max-width: 660px;
      margin: 0 auto;
    }

    .essay-tag {
      font-family: 'Lato', sans-serif;
      font-size: 0.58rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      color: #999;
      background: rgba(0,0,0,0.06);
      padding: 0.3rem 0.75rem;
    }

    /* ===== BACK LINK ===== */
    .essay-back {
      max-width: 660px;
      margin: 0 auto;
      padding: 0.5rem 2rem 4rem;
      text-align: center;
    }

    .essay-back a {
      font-family: 'Lato', sans-serif;
      font-size: 0.65rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.15em;
      color: #999;
      text-decoration: none;
      border-bottom: 1px solid #ccc;
      padding-bottom: 2px;
      transition: color 0.2s;
    }

    .essay-back a:hover { color: #333; }

    /* Reihen-Nav Styling aus altem Block entfernen */
    .essay-content hr + p em {
      display: unset;
      font-style: unset;
      font-family: unset;
      font-size: unset;
      text-transform: unset;
      letter-spacing: unset;
      color: unset;
      text-align: unset;
      padding: unset;
    }

    .essay-content hr + p em a {
      color: unset;
      border-bottom: unset;
      letter-spacing: unset;
      padding-bottom: unset;
    }

    @media(max-width:720px) {
      .essay-content { padding: 2rem 1.5rem 2.5rem; }
      .essay-content > p:last-child { margin: 2rem -1.5rem -2.5rem; padding: 1rem 1.5rem; }
      .essay-hero h1 { font-size: 1.85rem; }
    }
  </style>

  <!-- Hero -->
  <section class="essay-hero">
    <span class="label">{katLabel}</span>
    <h1>{entry.data.title}</h1>
    {entry.data.subtitle && <p class="subtitle">{entry.data.subtitle}</p>}
    <span class="meta-line">
      <span class="typ-badge">{entry.data.typ}</span>
      {entry.data.author}
    </span>
  </section>

  <!-- Content (rendered Markdown) -->
  <article class:list={['essay-content', { theological: entry.data.kategorie === 'denken' }]}>
    <Content />
  </article>

  <!-- Tags -->
  {entry.data.tags && entry.data.tags.length > 0 && (
    <div class="essay-tags">
      {entry.data.tags.map(tag => (
        <span class="essay-tag">{tag}</span>
      ))}
    </div>
  )}

  <!-- Back -->
  <div class="essay-back">
    <a href="/texte">← Alle Texte</a>
  </div>

</BaseLayout>
