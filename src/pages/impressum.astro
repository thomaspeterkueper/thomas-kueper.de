---
// Pfad: src/pages/impressum.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLegalInfo, legalAddressLines } from '../lib/legal';

const legal = await getLegalInfo();
const addressLines = legalAddressLines(legal.address);
---

<BaseLayout
  title="Impressum"
  description="Impressum und Kontaktinformationen von Thomas Peter Küper">

  <article class="container" style="max-width: 800px; padding: 8rem 2rem; font-family: 'Lora', serif; line-height: 1.8;">
    <h1 style="font-family: 'Crimson Text', serif; font-size: 3rem; margin-bottom: 3rem; border-bottom: 1px solid var(--gold-light); padding-bottom: 1rem;">Impressum</h1>

    <section style="margin-bottom: 3rem;">
      <h2 style="font-family: 'Lato', sans-serif; font-size: 1rem; text-transform: uppercase; letter-spacing: 2px; color: var(--gold); margin-bottom: 1rem;">Angaben gemäß § 5 TMG</h2>
      <p>
        <strong>{legal.responsible}</strong><br>
        {addressLines.map((line) => <>{line}<br /></>)}
      </p>
    </section>

    <section style="margin-bottom: 3rem;">
      <h2 style="font-family: 'Lato', sans-serif; font-size: 1rem; text-transform: uppercase; letter-spacing: 2px; color: var(--gold); margin-bottom: 1rem;">Kontakt</h2>
      <p><strong>E-Mail:</strong> <a href={`mailto:${legal.email}`} style="color: var(--brand-blue);">{legal.email}</a></p>
    </section>

    <section style="margin-bottom: 3rem;">
      <h2 style="font-family: 'Lato', sans-serif; font-size: 1rem; text-transform: uppercase; letter-spacing: 2px; color: var(--gold); margin-bottom: 1rem;">Verantwortlich für den Inhalt nach § 18 Abs. 2 MStV</h2>
      <p>{legal.responsible}<br>{legal.address}</p>
    </section>

    <section style="font-size: 0.9rem; color: var(--text-muted);">
      <h2 style="font-family: 'Lato', sans-serif; font-size: 1rem; text-transform: uppercase; letter-spacing: 2px; color: var(--gold); margin-bottom: 1rem;">Urheberrecht</h2>
      <p>
        Alle literarischen Werke, philosophischen Konzepte (insbesondere das AVI-Modell und
        die Omnizedenz-Philosophie) sowie alle fiktionalen Universen (Omnizedenz-Saga,
        Baumeister-Universum, NOXIA Universe, Zereya-Saga) sind geistiges Eigentum von
        Thomas Peter Küper.
      </p>
      <p style="margin-top: 1rem;">
        Die durch den Seitenbetreiber erstellten Inhalte auf diesen Seiten unterliegen dem
        deutschen Urheberrecht. Die Vervielfältigung, Bearbeitung und Verbreitung bedürfen
        der schriftlichen Zustimmung.
      </p>
      <p style="margin-top: 1rem; font-size: 0.8rem; opacity: 0.7;">Stand: August 2026</p>
    </section>
  </article>
</BaseLayout>
